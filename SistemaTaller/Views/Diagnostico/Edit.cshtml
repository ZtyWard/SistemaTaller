@model Negocios.DTOs.DiagnosticoGuardarDto

@{
    ViewData["Title"] = "Editar diagnóstico";
}

<section class="axis-page">

    <div class="axis-page-header">

        <div>

            <span class="axis-page-kicker">
                SERVICIO · DIAGNÓSTICO
            </span>

            <h1>
                Editar diagnóstico
            </h1>

            <p>
                Actualiza la información de la evaluación técnica.
            </p>

        </div>

        <div class="axis-page-actions">

            <a asp-action="Details"
               asp-route-id="@ViewBag.IdDiagnostico"
               class="axis-button axis-button-secondary">
                Ver diagnóstico
            </a>

            <a asp-action="Index"
               class="axis-button axis-button-secondary">
                ← Volver
            </a>

        </div>

    </div>


    <div class="axis-form-card">

        <form asp-action="Edit"
              asp-route-id="@ViewBag.IdDiagnostico"
              method="post"
              class="axis-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="axis-form-validation">
            </div>


            <div class="axis-form-section">

                <div class="axis-form-section-title">
                    Información del diagnóstico
                </div>

                <div class="axis-form-grid">


                    <div class="axis-field">

                        <label asp-for="IdRecepcion">
                            Recepción
                        </label>

                        <input asp-for="IdRecepcion"
                               type="number"
                               min="1" />

                        <span asp-validation-for="IdRecepcion"></span>

                    </div>


                    <div class="axis-field">

                        <label asp-for="IdEmpleado">
                            Empleado
                        </label>

                        <input asp-for="IdEmpleado"
                               type="number"
                               min="1" />

                        <span asp-validation-for="IdEmpleado"></span>

                    </div>


                    <div class="axis-field axis-field-full">

                        <label asp-for="Descripcion">
                            Descripción
                        </label>

                        <textarea asp-for="Descripcion"
                                  rows="6"
                                  placeholder="Describe los hallazgos y evaluación técnica..."></textarea>

                        <span asp-validation-for="Descripcion"></span>

                    </div>

                </div>

            </div>


            <div class="axis-form-actions">

                <a asp-action="Index"
                   class="axis-button axis-button-secondary">
                    Cancelar
                </a>

                <button type="submit"
                        class="axis-button axis-button-primary">
                    Guardar cambios
                </button>

            </div>

        </form>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}