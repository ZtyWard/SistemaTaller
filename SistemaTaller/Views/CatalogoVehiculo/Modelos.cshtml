@model IEnumerable<Negocios.DTOs.ModeloDto>

@{
    ViewData["Title"] = "Modelos";
}

<section class="axis-page">

    <div class="axis-page-header">

        <div>

            <span class="axis-page-kicker">
                CATÁLOGOS · VEHÍCULOS
            </span>

            <h1>Modelos</h1>

            <p>
                Administra los modelos asociados a las marcas del taller.
            </p>

        </div>

        <div class="axis-page-actions">

            <a asp-action="ModelosActivos"
               class="axis-button axis-button-secondary">
                Activos
            </a>

            <a asp-action="CrearModelo"
               class="axis-button axis-button-primary">
                + Nuevo modelo
            </a>

        </div>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="axis-alert axis-alert-success">
            @TempData["Success"]
        </div>
    }


    <div class="axis-toolbar">

        <div>

            <strong>
                @Model.Count() modelos
            </strong>

            <span class="axis-table-secondary-text">
                registrados en el catálogo
            </span>

        </div>

    </div>


    <div class="axis-table-card">

        <div class="axis-table-wrapper">

            <table class="axis-table">

                <thead>

                    <tr>

                        <th>
                            MODELO
                        </th>

                        <th>
                            MARCA
                        </th>

                        <th>
                            IDENTIFICADOR
                        </th>

                        <th>
                            ESTADO
                        </th>

                        <th>
                            ACCIONES
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="5"
                                class="axis-empty">

                                <div style="padding:40px 20px;">

                                    <strong>
                                        No hay modelos registrados
                                    </strong>

                                    <div class="axis-table-secondary-text">
                                        Comienza agregando el primer modelo al catálogo.
                                    </div>

                                </div>

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var modelo in Model)
                        {
                            <tr>

                                <td>

                                    <div class="axis-client-cell">

                                        <div class="axis-client-avatar">
                                            @(string.IsNullOrWhiteSpace(modelo.Nombre)
                                                                                ? "?"
                                                                                : modelo.Nombre.Substring(0, 1).ToUpper())
                                </div>

                                        <div>

                                            <strong>
                                                @modelo.Nombre
                                            </strong>

                                            <small class="axis-table-secondary-text">
                                                Modelo de vehículo
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <td>

                                    <strong>
                                        @modelo.MarcaNombre
                                    </strong>

                                    <small class="axis-table-secondary-text">
                                        #@modelo.IdMarca
                                    </small>

                                </td>


                                <td>
                                    #@modelo.IdModelo
                                </td>


                                <td>

                            @if (modelo.Activo)
                                    {
                                        <span class="axis-status axis-status-active">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="axis-status">
                                            Inactivo
                                        </span>
                                    }

                        </td>


                        <td>

                            <div class="axis-row-actions">

                                <a asp-action="DetalleModelo"
                                   asp-route-id="@modelo.IdModelo"
                                   class="axis-row-action">
                                    Ver
                                </a>

                                <a asp-action="EditarModelo"
                                   asp-route-id="@modelo.IdModelo"
                                   class="axis-row-action">
                                    Editar
                                </a>

                                <form asp-action="CambiarEstadoModelo"
                                      asp-route-id="@modelo.IdModelo"
                                      method="post"
                                      style="display:inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="activo"
                                           value="@(!modelo.Activo).ToString().ToLower()" />

                                    <button type="submit"
                                            class="axis-row-action">

                                        @(modelo.Activo
                                                                                ? "Desactivar"
                                                                                : "Activar")

                                    </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</section>