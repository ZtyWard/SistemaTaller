@model Negocios.DTOs.CompraGuardarDto

@{
    ViewData["Title"] = "Editar compra";
}

<section class="axis-page">

    <!-- ================================================= -->
    <!-- ENCABEZADO -->
    <!-- ================================================= -->

    <div class="axis-page-header">

        <div>

            <span class="axis-page-kicker">
                INVENTARIO · COMPRAS
            </span>

            <h1>
                Editar compra
            </h1>

            <p>
                Actualiza la información de la compra seleccionada.
            </p>

        </div>

        <div class="axis-page-actions">

            <a asp-action="Details"
               asp-route-id="@ViewBag.IdCompra"
               class="axis-button axis-button-secondary">
                Ver compra
            </a>

            <a asp-action="Index"
               class="axis-button axis-button-secondary">
                ← Volver
            </a>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- FORMULARIO -->
    <!-- ================================================= -->

    <div class="axis-form-card">

        <form asp-action="Edit"
              asp-route-id="@ViewBag.IdCompra"
              method="post"
              class="axis-form">

            @Html.AntiForgeryToken()


            <!-- ============================================= -->
            <!-- ERRORES -->
            <!-- ============================================= -->

            <div asp-validation-summary="ModelOnly"
                 class="axis-form-validation">
            </div>


            <!-- ============================================= -->
            <!-- INFORMACIÓN DE LA COMPRA -->
            <!-- ============================================= -->

            <div class="axis-form-section">

                <div class="axis-form-section-title">
                    Información de la compra
                </div>


                <div class="axis-form-grid">


                    <!-- PROVEEDOR -->

                    <div class="axis-field">

                        <label asp-for="IdProveedor">
                            Proveedor
                        </label>

                        <input asp-for="IdProveedor"
                               type="number"
                               min="1" />

                        <span asp-validation-for="IdProveedor"></span>

                    </div>


                    <!-- FECHA -->

                    <div class="axis-field">

                        <label asp-for="FechaCompra">
                            Fecha de compra
                        </label>

                        <input asp-for="FechaCompra"
                               type="date" />

                        <span asp-validation-for="FechaCompra"></span>

                    </div>


                    <!-- TOTAL -->

                    <div class="axis-field">

                        <label asp-for="Total">
                            Total calculado
                        </label>

                        <input asp-for="Total"
                               type="number"
                               step="0.01"
                               min="0"
                               readonly />

                        <span asp-validation-for="Total"></span>

                    </div>


                    <!-- ESTADO -->

                    <div class="axis-field">

                        <label asp-for="Estado">
                            Estado
                        </label>

                        <select asp-for="Estado">

                            <option value="Pendiente">
                                Pendiente
                            </option>

                            <option value="Completada">
                                Completada
                            </option>

                            <option value="Cancelada">
                                Cancelada
                            </option>

                        </select>

                        <span asp-validation-for="Estado"></span>

                    </div>


                    <!-- FACTURA PROVEEDOR -->

                    <div class="axis-field">

                        <label asp-for="NumeroFacturaProveedor">
                            Número de factura del proveedor
                        </label>

                        <input asp-for="NumeroFacturaProveedor" />

                        <span asp-validation-for="NumeroFacturaProveedor"></span>

                    </div>


                    <!-- FORMA DE PAGO -->

                    <div class="axis-field">

                        <label asp-for="FormaPago">
                            Forma de pago
                        </label>

                        <input asp-for="FormaPago" />

                        <span asp-validation-for="FormaPago"></span>

                    </div>

                </div>

            </div>


            <!-- ============================================= -->
            <!-- DETALLES -->
            <!-- ============================================= -->

            <div class="axis-form-section">

                <div class="axis-form-section-title">
                    Detalle de la compra
                </div>


                @if (Model.Detalles != null &&
                                Model.Detalles.Count > 0)
                {

                    @for (int i = 0;
                                    i < Model.Detalles.Count;
                                    i++)
                    {

                        <div class="axis-form-grid"
                             style="margin-bottom: 24px;">

                            <!-- PRODUCTO -->

                            <div class="axis-field">

                                <label>
                                    Producto
                                </label>

                                <input asp-for="Detalles[i].IdProducto"
                                       type="number"
                                       min="1" />

                            </div>


                            <!-- CANTIDAD -->

                            <div class="axis-field">

                                <label>
                                    Cantidad
                                </label>

                                <input asp-for="Detalles[i].Cantidad"
                                       type="number"
                                       min="1" />

                            </div>


                            <!-- COSTO UNITARIO -->

                            <div class="axis-field">

                                <label>
                                    Costo unitario
                                </label>

                                <input asp-for="Detalles[i].CostoUnitario"
                                       type="number"
                                       min="0"
                                       step="0.01" />

                            </div>


                            <!-- IMPUESTO -->

                            <div class="axis-field">

                                <label>
                                    Impuesto
                                </label>

                                <input asp-for="Detalles[i].Impuesto"
                                       type="number"
                                       min="0"
                                       step="0.01" />

                            </div>


                            <!-- DESCUENTO -->

                            <div class="axis-field">

                                <label>
                                    Descuento
                                </label>

                                <input asp-for="Detalles[i].Descuento"
                                       type="number"
                                       min="0"
                                       step="0.01" />

                            </div>

                        </div>

                    }

                }
                else
                {

                    <div class="axis-form-validation">
                        Esta compra no tiene detalles registrados.
                    </div>

                }

            </div>


            <!-- ============================================= -->
            <!-- BOTONES -->
            <!-- ============================================= -->

            <div class="axis-form-actions">

                <a asp-action="Index"
                   class="axis-button axis-button-secondary">
                    Cancelar
                </a>

                <button type="submit"
                        class="axis-button axis-button-primary">
                    Guardar cambios
                </button>

            </div>

        </form>

    </div>

</section>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}