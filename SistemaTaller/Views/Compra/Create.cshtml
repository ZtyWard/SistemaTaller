@model Negocios.DTOs.CompraGuardarDto

@{
    ViewData["Title"] = "Nueva compra";
}

<section class="axis-page">

    <div class="axis-page-header">

        <div>

            <span class="axis-page-kicker">
                INVENTARIO · COMPRAS
            </span>

            <h1>
                Nueva compra
            </h1>

            <p>
                Registra una nueva compra realizada a un proveedor.
            </p>

        </div>

        <a asp-action="Index"
           class="axis-button axis-button-secondary">
            ← Volver
        </a>

    </div>


    <div class="axis-form-card">

        <form asp-action="Create"
              method="post"
              class="axis-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="axis-form-validation">
            </div>


            <!-- =====================================================
                 INFORMACIÓN DE LA COMPRA
                 ===================================================== -->

            <div class="axis-form-section">

                <div class="axis-form-section-title">
                    Información de la compra
                </div>

                <div class="axis-form-grid">


                    <!-- PROVEEDOR -->

                    <div class="axis-field">

                        <label asp-for="IdProveedor">
                            Proveedor
                        </label>

                        <input asp-for="IdProveedor"
                               type="number"
                               min="1"
                               placeholder="ID del proveedor" />

                        <span asp-validation-for="IdProveedor"></span>

                    </div>


                    <!-- FECHA -->

                    <div class="axis-field">

                        <label asp-for="FechaCompra">
                            Fecha de compra
                        </label>

                        <input asp-for="FechaCompra"
                               type="date" />

                        <span asp-validation-for="FechaCompra"></span>

                    </div>


                    <!-- TOTAL -->

                    <div class="axis-field">

                        <label asp-for="Total">
                            Total
                        </label>

                        <input asp-for="Total"
                               type="number"
                               step="0.01"
                               min="0"
                               placeholder="0.00" />

                        <span asp-validation-for="Total"></span>

                    </div>


                    <!-- ESTADO -->

                    <div class="axis-field">

                        <label asp-for="Estado">
                            Estado
                        </label>

                        <select asp-for="Estado">

                            <option value="Pendiente">
                                Pendiente
                            </option>

                            <option value="Completada">
                                Completada
                            </option>

                            <option value="Cancelada">
                                Cancelada
                            </option>

                        </select>

                        <span asp-validation-for="Estado"></span>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 DETALLE DE LA COMPRA
                 ===================================================== -->

            <div class="axis-form-section">

                <div class="axis-form-section-title">
                    Detalle de la compra
                </div>


                <div class="axis-form-grid">


                    <!-- PRODUCTO -->

                    <div class="axis-field">

                        <label>
                            Producto
                        </label>

                        <input type="number"
                               name="Detalles[0].IdProducto"
                               value="3"
                               min="1"
                               placeholder="ID del producto"
                               required />

                        <small>
                            ID del producto que se está comprando.
                        </small>

                    </div>


                    <!-- CANTIDAD -->

                    <div class="axis-field">

                        <label>
                            Cantidad
                        </label>

                        <input type="number"
                               name="Detalles[0].Cantidad"
                               value="1"
                               min="1"
                               required />

                    </div>


                    <!-- COSTO UNITARIO -->

                    <div class="axis-field">

                        <label>
                            Costo unitario
                        </label>

                        <input type="number"
                               name="Detalles[0].CostoUnitario"
                               value="1000"
                               step="0.01"
                               min="0"
                               required />

                    </div>


                    <!-- IMPUESTO -->

                    <div class="axis-field">

                        <label>
                            Impuesto
                        </label>

                        <input type="number"
                               name="Detalles[0].Impuesto"
                               value="0"
                               step="0.01"
                               min="0" />

                    </div>


                    <!-- DESCUENTO -->

                    <div class="axis-field">

                        <label>
                            Descuento
                        </label>

                        <input type="number"
                               name="Detalles[0].Descuento"
                               value="0"
                               step="0.01"
                               min="0" />

                    </div>

                </div>


                <p style="margin-top: 16px; opacity: .65;">

                    Producto de prueba:
                    <strong>TEST-001</strong>
                    · ID 3

                </p>

            </div>


            <!-- =====================================================
                 ACCIONES
                 ===================================================== -->

            <div class="axis-form-actions">

                <a asp-action="Index"
                   class="axis-button axis-button-secondary">

                    Cancelar

                </a>


                <button type="submit"
                        class="axis-button axis-button-primary">

                    Registrar compra

                </button>

            </div>


        </form>

    </div>

</section>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}