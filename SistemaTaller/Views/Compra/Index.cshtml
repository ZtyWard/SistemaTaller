@model IEnumerable<Negocios.DTOs.CompraDto>

@{
    ViewData["Title"] = "Compras";
}

<section class="axis-page">

    <div class="axis-page-header">

        <div>
            <span class="axis-page-kicker">
                INVENTARIO · COMPRAS
            </span>

            <h1>
                Compras
            </h1>

            <p>
                Gestiona las compras realizadas a los proveedores del taller.
            </p>
        </div>

        <div class="axis-page-actions">

            <a asp-action="PorEstado"
               asp-route-estado="Pendiente"
               class="axis-button axis-button-secondary">
                Pendientes
            </a>

            <a asp-action="Recientes"
               asp-route-cantidad="10"
               class="axis-button axis-button-secondary">
                Recientes
            </a>

            <a asp-action="Create"
               class="axis-button axis-button-primary">
                + Nueva compra
            </a>

        </div>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="axis-alert axis-alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="axis-alert axis-alert-error">
            @TempData["Error"]
        </div>
    }


    <div class="axis-toolbar">

        <span class="axis-record-count">
            @Model.Count() compras registradas
        </span>

    </div>


    <div class="axis-table-card">

        <div class="axis-table-wrapper">

            <table class="axis-table">

                <thead>

                    <tr>

                        <th>
                            Compra
                        </th>

                        <th>
                            Proveedor
                        </th>

                        <th>
                            Fecha
                        </th>

                        <th>
                            Total
                        </th>

                        <th>
                            Estado
                        </th>

                        <th class="axis-table-actions-column">
                            Acciones
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="6"
                                class="axis-empty">

                                No hay compras registradas.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var compra in Model)
                        {
                            <tr>

                                <td>

                                    <div class="axis-client-cell">

                                        <div class="axis-client-avatar">
                                            C
                                        </div>

                                        <div>

                                            <strong>
                                                Compra #@compra.IdCompra
                                            </strong>

                                            <small class="axis-table-secondary-text">
                                                Registro de compra
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <td>

                                    <div>

                                        <strong>
                                            @compra.Proveedor
                                        </strong>

                                        <small class="axis-table-secondary-text">
                                            Proveedor #@compra.IdProveedor
                                        </small>

                                    </div>

                                </td>


                                <td>
                                    @compra.FechaCompra.ToString("dd/MM/yyyy")
                                </td>


                                <td>

                                    <strong>
                                        ₡@compra.Total.ToString("N2")
                                    </strong>

                                </td>


                                <td>

                                    @if (compra.Estado.Equals(
                                                                "Pendiente",
                                                                StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="axis-status axis-status-warning">
                                            @compra.Estado
                                        </span>
                                    }
                                    else if (compra.Estado.Equals(
                                    "Completada",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="axis-status axis-status-active">
                                            @compra.Estado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="axis-status axis-status-inactive">
                                            @compra.Estado
                                        </span>
                                    }

                                </td>


                                <td>

                                    <div class="axis-row-actions">

                                        <a asp-action="Details"
                                           asp-route-id="@compra.IdCompra"
                                           class="axis-row-action">
                                            Ver
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@compra.IdCompra"
                                           class="axis-row-action">
                                            Editar
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</section>