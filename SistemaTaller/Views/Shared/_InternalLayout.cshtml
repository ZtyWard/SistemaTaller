@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    string UsuarioNombre =
        User.Identity?.Name ?? "Usuario";

    string Inicial =
        string.IsNullOrWhiteSpace(UsuarioNombre)
            ? "U"
            : UsuarioNombre.Substring(0, 1).ToUpper();

    bool EsModulo(params string[] controladores)
        => controller != null &&
           controladores.Contains(controller);
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - AXIS
    </title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @await RenderSectionAsync(
    "Styles",
        required: false)

</head>


<body>

    <div class="axis-internal-app">


        <!-- =====================================================
             SIDEBAR
             ===================================================== -->

        <aside class="axis-internal-sidebar">


            <!-- BRAND -->

            <div class="axis-internal-brand">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="axis-internal-logo">

                    <span class="axis-internal-logo-name">
                        AXIS
                    </span>

                    <span class="axis-internal-logo-subtitle">
                        TALLER AUTOMOTRIZ
                    </span>

                </a>


            </div>


            <!-- NAVIGATION -->

            <nav class="axis-internal-navigation">


                <!-- =================================================
                     TALLER
                     ================================================= -->

                <div class="axis-internal-section">

                    <span class="axis-internal-section-title">
                        TALLER
                    </span>


                    <a asp-controller="Recepcion"
                       asp-action="Index"
                       class="axis-internal-nav-item @(EsModulo("Recepcion") ? "active" : "")">

                        <span class="axis-internal-nav-icon">
                            ◫
                        </span>

                        <span>
                            Recepciones
                        </span>

                    </a>


                    <a asp-controller="Diagnostico"
                       asp-action="Index"
                       class="axis-internal-nav-item @(EsModulo("Diagnostico") ? "active" : "")">

                        <span class="axis-internal-nav-icon">
                            ⌕
                        </span>

                        <span>
                            Diagnósticos
                        </span>

                    </a>


                    <a asp-controller="Cotizacion"
                       asp-action="Index"
                       class="axis-internal-nav-item @(EsModulo("Cotizacion") ? "active" : "")">

                        <span class="axis-internal-nav-icon">
                            ▤
                        </span>

                        <span>
                            Cotizaciones
                        </span>

                    </a>


                    <a asp-controller="OrdenTrabajo"
                       asp-action="Index"
                       class="axis-internal-nav-item @(EsModulo("OrdenTrabajo") ? "active" : "")">

                        <span class="axis-internal-nav-icon">
                            ▣
                        </span>

                        <span>
                            Órdenes de trabajo
                        </span>

                    </a>

                </div>


                <!-- =================================================
                     CLIENTES Y VEHÍCULOS
                     ================================================= -->

                <div class="axis-internal-section">

                    <span class="axis-internal-section-title">
                        CLIENTES Y VEHÍCULOS
                    </span>


                    <a asp-controller="Cliente"
                       asp-action="Index"
                       class="axis-internal-nav-item @(EsModulo("Cliente") ? "active" : "")">

                        <span class="axis-internal-nav-icon">
                            ♙
                        </span>

                        <span>
                            Clientes
                        </span>

                    </a>


                    <a asp-controller="Vehiculo"
                       asp-action="Index"
                       class="axis-internal-nav-item @(EsModulo("Vehiculo") ? "active" : "")">

                        <span class="axis-internal-nav-icon">
                            ▱
                        </span>

                        <span>
                            Vehículos
                        </span>

                    </a>

                </div>


                <!-- =================================================
                     EMPLEADOS Y SERVICIOS
                     ================================================= -->

                <div class="axis-internal-section">

                    <span class="axis-internal-section-title">
                        EMPLEADOS Y SERVICIOS
                    </span>


                    <a asp-controller="Empleado"
                       asp-action="Index"
                       class="axis-internal-nav-item @(EsModulo("Empleado") ? "active" : "")">

                        <span class="axis-internal-nav-icon">
                            ♟
                        </span>

                        <span>
                            Empleados
                        </span>

                    </a>


                    <a asp-controller="Servicio"
                       asp-action="Index"
                       class="axis-internal-nav-item @(EsModulo("Servicio") ? "active" : "")">

                        <span class="axis-internal-nav-icon">
                            ⌁
                        </span>

                        <span>
                            Servicios
                        </span>

                    </a>

                </div>


                <!-- =================================================
                     INVENTARIO
                     ================================================= -->

                <div class="axis-internal-section">

                    <span class="axis-internal-section-title">
                        INVENTARIO
                    </span>


                    <a asp-controller="Producto"
                       asp-action="Index"
                       class="axis-internal-nav-item @(EsModulo("Producto") ? "active" : "")">

                        <span class="axis-internal-nav-icon">
                            ◇
                        </span>

                        <span>
                            Productos
                        </span>

                    </a>


                    <a asp-controller="MovimientoInventario"
                       asp-action="Index"
                       class="axis-internal-nav-item @(EsModulo("MovimientoInventario") ? "active" : "")">

                        <span class="axis-internal-nav-icon">
                            ⇄
                        </span>

                        <span>
                            Movimientos
                        </span>

                    </a>


                    <a asp-controller="Proveedor"
                       asp-action="Index"
                       class="axis-internal-nav-item @(EsModulo("Proveedor") ? "active" : "")">

                        <span class="axis-internal-nav-icon">
                            ♧
                        </span>

                        <span>
                            Proveedores
                        </span>

                    </a>

                </div>


                <!-- =================================================
                     COMPRAS Y VENTAS
                     ================================================= -->

                <div class="axis-internal-section">

                    <span class="axis-internal-section-title">
                        COMPRAS Y VENTAS
                    </span>


                    <a asp-controller="Compra"
                       asp-action="Index"
                       class="axis-internal-nav-item @(EsModulo("Compra") ? "active" : "")">

                        <span class="axis-internal-nav-icon">
                            ▣
                        </span>

                        <span>
                            Compras
                        </span>

                    </a>

                </div>


                <!-- =================================================
                     CATÁLOGOS
                     ================================================= -->

                <div class="axis-internal-section">

                    <span class="axis-internal-section-title">
                        CATÁLOGOS
                    </span>


                    <a asp-controller="CatalogoProducto"
                       asp-action="Categorias"
                       class="axis-internal-nav-item @(EsModulo("CatalogoProducto") ? "active" : "")">

                        <span class="axis-internal-nav-icon">
                            ◈
                        </span>

                        <span>
                            Productos
                        </span>

                    </a>


                    <a asp-controller="CatalogoVehiculo"
                       asp-action="Marcas"
                       class="axis-internal-nav-item @(EsModulo("CatalogoVehiculo") ? "active" : "")">

                        <span class="axis-internal-nav-icon">
                            ◇
                        </span>

                        <span>
                            Vehículos
                        </span>

                    </a>


                    <a asp-controller="CatalogoPersonal"
                       asp-action="Especialidades"
                       class="axis-internal-nav-item @(EsModulo("CatalogoPersonal") ? "active" : "")">

                        <span class="axis-internal-nav-icon">
                            ⚙
                        </span>

                        <span>
                            Personal
                        </span>

                    </a>

                </div>


            </nav>


            <!-- =====================================================
                 USER
                 ===================================================== -->

            <div class="axis-internal-user">

                <div class="axis-user-avatar">

                    @Inicial

                </div>


                <div class="axis-internal-user-info">

                    <strong>
                        @UsuarioNombre
                    </strong>

                    <span>
                        Usuario del sistema
                    </span>

                </div>

            </div>


        </aside>


        <!-- =====================================================
             CONTENT
             ===================================================== -->

        <div class="axis-internal-content">


            <!-- TOPBAR -->

            <header class="axis-internal-topbar">


                <a asp-controller="Home"
                   asp-action="Index"
                   class="axis-internal-back">

                    ←

                    <span>
                        Menú principal
                    </span>

                </a>


                <span class="axis-internal-page-title">

                    @ViewData["Title"]

                </span>


                <div class="axis-internal-actions">


                    <button type="button"
                            class="axis-internal-action"
                            title="Notificaciones">

                        ◐

                    </button>


                    <button type="button"
                            class="axis-internal-action"
                            title="Modo visual">

                        ◑

                    </button>


                    <span class="axis-internal-user-name">

                        @UsuarioNombre

                    </span>


                </div>

            </header>


            <!-- MAIN -->

            <main class="axis-internal-main">

                @RenderBody()

            </main>


        </div>

    </div>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->
    <!-- jQuery DEBE cargarse antes de jquery.validate -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const button =
                    document.getElementById(
                        "axisInternalCollapse"
                    );

                if (!button)
                    return;

                button.addEventListener(
                    "click",
                    function () {

                        /*
                         * La estructura visual del
                         * sidebar ya está preparada
                         * en site.css.
                         *
                         * Por ahora dejamos el botón
                         * preparado para la siguiente
                         * fase de interacción.
                         */

                        button.classList.toggle(
                            "is-active"
                        );

                    }
                );

            }
        );

    </script>

</body>

</html>