@using Negocios.Seguridad

@{
    var controller =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var action =
        ViewContext.RouteData.Values["action"]?.ToString();

    string UsuarioNombre =
        User.Identity?.Name ?? "Usuario";

    string Inicial =
        string.IsNullOrWhiteSpace(UsuarioNombre)
            ? "U"
            : UsuarioNombre.Substring(0, 1).ToUpper();

    bool EsModulo(params string[] controladores)
        => controller != null &&
           controladores.Contains(controller);

    bool TienePermiso(string permiso)
        => User.HasClaim("Permiso", permiso);

    bool EsAdministrador =
        User.IsInRole("Administrador");
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - AXIS
    </title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @await RenderSectionAsync(
    "Styles",
        required: false)

</head>


<body>

    <div class="axis-internal-app">


        <!-- =====================================================
             SIDEBAR
             ===================================================== -->

        <aside class="axis-internal-sidebar">


            <!-- =================================================
                 BRAND
                 ================================================= -->

            <div class="axis-internal-brand">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="axis-internal-logo">

                    <span class="axis-internal-logo-name">
                        AXIS
                    </span>

                    <span class="axis-internal-logo-subtitle">
                        TALLER AUTOMOTRIZ
                    </span>

                </a>

            </div>


            <!-- =================================================
                 NAVIGATION
                 ================================================= -->

            <nav class="axis-internal-navigation">


                <!-- =================================================
                     INICIO
                     ================================================= -->

                <div class="axis-internal-section">

                    <span class="axis-internal-section-title">
                        INICIO
                    </span>


                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="axis-internal-nav-item @(EsModulo("Dashboard") ? "active" : "")">

                        <span class="axis-internal-nav-icon">
                            ◉
                        </span>

                        <span>
                            Dashboard
                        </span>

                    </a>

                </div>


                <!-- =================================================
                     OPERACIÓN
                     ================================================= -->
                @if (
                                TienePermiso(Permisos.CitasVer) ||
                                TienePermiso(Permisos.RecepcionesVer) ||
                                TienePermiso(Permisos.DiagnosticosVer) ||
                                TienePermiso(Permisos.CotizacionesVer) ||
                                TienePermiso(Permisos.OrdenesVer)
                                )
                {
                    <div class="axis-internal-section">

                        <span class="axis-internal-section-title">
                            OPERACIÓN
                        </span>


                        @if (TienePermiso(Permisos.CitasVer))
                        {
                            <a asp-controller="Cita"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("Cita") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ◷
                                </span>

                                <span>
                                    Citas
                                </span>

                            </a>
                        }


                        @if (TienePermiso(Permisos.RecepcionesVer))
                        {
                            <a asp-controller="Recepcion"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("Recepcion") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ◫
                                </span>

                                <span>
                                    Recepciones
                                </span>

                            </a>
                        }


                        @if (TienePermiso(Permisos.DiagnosticosVer))
                        {
                            <a asp-controller="Diagnostico"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("Diagnostico") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ⌕
                                </span>

                                <span>
                                    Diagnósticos
                                </span>

                            </a>
                        }


                        @if (TienePermiso(Permisos.CotizacionesVer))
                        {
                            <a asp-controller="Cotizacion"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("Cotizacion") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ▤
                                </span>

                                <span>
                                    Cotizaciones
                                </span>

                            </a>
                        }


                        @if (TienePermiso(Permisos.OrdenesVer))
                        {
                            <a asp-controller="OrdenTrabajo"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("OrdenTrabajo") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ▣
                                </span>

                                <span>
                                    Órdenes de trabajo
                                </span>

                            </a>


                            <a asp-controller="Entrega"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("Entrega") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ↗
                                </span>

                                <span>
                                    Entregas
                                </span>

                            </a>
                        }

                    </div>
                }


                <!-- =================================================
                     CLIENTES
                     ================================================= -->
                @if (
                                TienePermiso(Permisos.ClientesVer) ||
                                TienePermiso(Permisos.VehiculosVer)
                                )
                {
                    <div class="axis-internal-section">

                        <span class="axis-internal-section-title">
                            CLIENTES
                        </span>


                        @if (TienePermiso(Permisos.ClientesVer))
                        {
                            <a asp-controller="Cliente"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("Cliente") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ♙
                                </span>

                                <span>
                                    Clientes
                                </span>

                            </a>
                        }


                        @if (TienePermiso(Permisos.VehiculosVer))
                        {
                            <a asp-controller="Vehiculo"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("Vehiculo") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ▱
                                </span>

                                <span>
                                    Vehículos
                                </span>

                            </a>
                        }

                    </div>
                }


                <!-- =================================================
                     TALLER
                     ================================================= -->
                @if (
                                TienePermiso(Permisos.EmpleadosVer) ||
                                TienePermiso(Permisos.ServiciosVer)
                                )
                {
                    <div class="axis-internal-section">

                        <span class="axis-internal-section-title">
                            TALLER
                        </span>


                        @if (TienePermiso(Permisos.ServiciosVer))
                        {
                            <a asp-controller="Servicio"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("Servicio") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ⌁
                                </span>

                                <span>
                                    Servicios
                                </span>

                            </a>
                        }


                        @if (TienePermiso(Permisos.EmpleadosVer))
                        {
                            <a asp-controller="Empleado"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("Empleado") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ♟
                                </span>

                                <span>
                                    Empleados
                                </span>

                            </a>
                        }

                    </div>
                }


                <!-- =================================================
                     INVENTARIO
                     ================================================= -->
                @if (
                                TienePermiso(Permisos.ProductosVer) ||
                                TienePermiso(Permisos.MovimientosInventarioVer) ||
                                TienePermiso(Permisos.ProveedoresVer) ||
                                TienePermiso(Permisos.ComprasVer)
                                )
                {
                    <div class="axis-internal-section">

                        <span class="axis-internal-section-title">
                            INVENTARIO
                        </span>


                        @if (TienePermiso(Permisos.ProductosVer))
                        {
                            <a asp-controller="Producto"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("Producto") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ◇
                                </span>

                                <span>
                                    Productos
                                </span>

                            </a>
                        }


                        @if (TienePermiso(Permisos.MovimientosInventarioVer))
                        {
                            <a asp-controller="MovimientoInventario"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("MovimientoInventario") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ⇄
                                </span>

                                <span>
                                    Movimientos
                                </span>

                            </a>
                        }


                        @if (TienePermiso(Permisos.ProveedoresVer))
                        {
                            <a asp-controller="Proveedor"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("Proveedor") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ♧
                                </span>

                                <span>
                                    Proveedores
                                </span>

                            </a>
                        }


                        @if (TienePermiso(Permisos.ComprasVer))
                        {
                            <a asp-controller="Compra"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("Compra") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    🛒
                                </span>

                                <span>
                                    Compras
                                </span>

                            </a>
                        }

                    </div>
                }


                <!-- =================================================
                     FINANZAS
                     ================================================= -->
                @if (
                                TienePermiso(Permisos.VentasVer) ||
                                TienePermiso(Permisos.FacturacionVer) ||
                                TienePermiso(Permisos.PagosVer)
                                )
                {
                    <div class="axis-internal-section">

                        <span class="axis-internal-section-title">
                            FINANZAS
                        </span>


                        @if (TienePermiso(Permisos.VentasVer))
                        {
                            <a asp-controller="Venta"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("Venta") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    $
                                </span>

                                <span>
                                    Ventas
                                </span>

                            </a>
                        }


                        @if (TienePermiso(Permisos.FacturacionVer))
                        {
                            <a asp-controller="Factura"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("Factura") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ▤
                                </span>

                                <span>
                                    Facturación
                                </span>

                            </a>
                        }


                        @if (TienePermiso(Permisos.PagosVer))
                        {
                            <a asp-controller="Pago"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("Pago") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ◉
                                </span>

                                <span>
                                    Pagos
                                </span>

                            </a>
                        }

                    </div>
                }


                <!-- =================================================
                     POSTVENTA
                     ================================================= -->
                @if (TienePermiso(Permisos.ReportesVer))
                {
                    <div class="axis-internal-section">

                        <span class="axis-internal-section-title">
                            POSTVENTA
                        </span>


                        <a asp-controller="Garantia"
                           asp-action="Index"
                           class="axis-internal-nav-item @(EsModulo("Garantia") ? "active" : "")">

                            <span class="axis-internal-nav-icon">
                                ◇
                            </span>

                            <span>
                                Garantías
                            </span>

                        </a>

                    </div>
                }


                <!-- =================================================
                     ANÁLISIS
                     ================================================= -->
                @if (TienePermiso(Permisos.ReportesVer))
                {
                    <div class="axis-internal-section">

                        <span class="axis-internal-section-title">
                            ANÁLISIS
                        </span>


                        <a asp-controller="Reportes"
                           asp-action="Index"
                           class="axis-internal-nav-item @(EsModulo("Reportes") ? "active" : "")">

                            <span class="axis-internal-nav-icon">
                                ◒
                            </span>

                            <span>
                                Reportes
                            </span>

                        </a>

                    </div>
                }


                <!-- =================================================
                     ADMINISTRACIÓN
                     ================================================= -->
                @if (
                                TienePermiso(Permisos.UsuariosVer) ||
                                TienePermiso(Permisos.RolesVer) ||
                                TienePermiso(Permisos.AuditoriaVer)
                                )
                {
                    <div class="axis-internal-section">

                        <span class="axis-internal-section-title">
                            ADMINISTRACIÓN
                        </span>


                        @if (TienePermiso(Permisos.UsuariosVer))
                        {
                            <a asp-controller="Usuario"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("Usuario") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ♙
                                </span>

                                <span>
                                    Usuarios
                                </span>

                            </a>
                        }


                        @if (TienePermiso(Permisos.RolesVer))
                        {
                            <a asp-controller="Rol"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("Rol") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ◈
                                </span>

                                <span>
                                    Roles y permisos
                                </span>

                            </a>
                        }


                        @if (TienePermiso(Permisos.AuditoriaVer))
                        {
                            <a asp-controller="Auditoria"
                               asp-action="Index"
                               class="axis-internal-nav-item @(EsModulo("Auditoria") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ◌
                                </span>

                                <span>
                                    Auditoría
                                </span>

                            </a>
                        }

                    </div>
                }


                <!-- =================================================
                     CONFIGURACIÓN
                     ================================================= -->
                @if (EsAdministrador)
                {
                    <div class="axis-internal-section">

                        <span class="axis-internal-section-title">
                            CONFIGURACIÓN
                        </span>


                        <a asp-controller="Configuracion"
                           asp-action="Index"
                           class="axis-internal-nav-item @(EsModulo("Configuracion") ? "active" : "")">

                            <span class="axis-internal-nav-icon">
                                ⚙
                            </span>

                            <span>
                                Configuración general
                            </span>

                        </a>


                        @if (TienePermiso(Permisos.ProductosVer))
                        {
                            <a asp-controller="CatalogoProducto"
                               asp-action="Categorias"
                               class="axis-internal-nav-item @(EsModulo("CatalogoProducto") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ◈
                                </span>

                                <span>
                                    Catálogo de productos
                                </span>

                            </a>
                        }


                        @if (TienePermiso(Permisos.VehiculosVer))
                        {
                            <a asp-controller="CatalogoVehiculo"
                               asp-action="Marcas"
                               class="axis-internal-nav-item @(EsModulo("CatalogoVehiculo") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ◇
                                </span>

                                <span>
                                    Catálogo de vehículos
                                </span>

                            </a>
                        }


                        @if (TienePermiso(Permisos.EmpleadosVer))
                        {
                            <a asp-controller="CatalogoPersonal"
                               asp-action="Especialidades"
                               class="axis-internal-nav-item @(EsModulo("CatalogoPersonal") ? "active" : "")">

                                <span class="axis-internal-nav-icon">
                                    ⚙
                                </span>

                                <span>
                                    Catálogo de personal
                                </span>

                            </a>
                        }

                    </div>
                }


            </nav>


            <!-- =====================================================
                 USER
                 ===================================================== -->

            <div class="axis-internal-user">

                <div class="axis-user-avatar">
                    @Inicial
                </div>


                <div class="axis-internal-user-info">

                    <strong>
                        @UsuarioNombre
                    </strong>

                    <span>
                        @(EsAdministrador
                                                ? "Administrador"
                                                : "Usuario del sistema")
                    </span>

                </div>

            </div>


        </aside>


        <!-- =====================================================
             CONTENT
             ===================================================== -->

        <div class="axis-internal-content">


            <!-- =================================================
                 TOPBAR
                 ================================================= -->

            <header class="axis-internal-topbar">


                <a asp-controller="Home"
                   asp-action="Index"
                   class="axis-internal-back">

                    ←

                    <span>
                        Menú principal
                    </span>

                </a>


                <span class="axis-internal-page-title">

                    @ViewData["Title"]

                </span>


                <div class="axis-internal-actions">


                    <!-- NOTIFICACIONES -->

                    <a asp-controller="Notificacion"
                       asp-action="Resumen"
                       class="axis-internal-action"
                       title="Notificaciones"
                       aria-label="Notificaciones">

                        ◐

                    </a>


                    <!-- MODO VISUAL -->

                    <button type="button"
                            class="axis-internal-action"
                            title="Modo visual"
                            aria-label="Modo visual">

                        ◑

                    </button>


                    <!-- USUARIO -->

                    <span class="axis-internal-user-name">

                        @UsuarioNombre

                    </span>

                </div>

            </header>


            <!-- =================================================
                 MAIN
                 ================================================= -->

            <main class="axis-internal-main">

                @RenderBody()

            </main>


        </div>

    </div>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>