@model IEnumerable<Negocios.DTOs.CategoriaProductoDto>

@{
    ViewData["Title"] = "Categorías de productos";
}

<div class="axis-page">

    <div class="axis-page-header">
        <div>
            <span class="axis-kicker">CATÁLOGO · PRODUCTOS</span>
            <h1>Categorías</h1>
            <p>Administra las categorías utilizadas para organizar los productos del taller.</p>
        </div>

        <a asp-action="CrearCategoria" class="axis-btn axis-btn-primary">
            + Nueva categoría
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="axis-alert axis-alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="axis-alert axis-alert-error">
            @TempData["Error"]
        </div>
    }

    <div class="axis-toolbar">

        <div class="axis-toolbar-info">
            <span>REGISTROS</span>
            <strong>@Model.Count()</strong>
        </div>

        <div class="axis-toolbar-actions">
            <a asp-action="Categorias"
               class="axis-filter @(Context.Request.Path.Value?.EndsWith("Categorias") == true ? "active" : "")">
                Todas
            </a>

            <a asp-action="CategoriasActivas"
               class="axis-filter">
                Activas
            </a>
        </div>

    </div>

    <div class="axis-table-card">

        @if (!Model.Any())
        {
            <div class="axis-empty">
                <span class="axis-empty-number">00</span>
                <h2>No hay categorías registradas</h2>
                <p>Comienza creando la primera categoría de productos.</p>

                <a asp-action="CrearCategoria"
                   class="axis-btn axis-btn-primary">
                    Crear categoría
                </a>
            </div>
        }
        else
        {
            <div class="axis-table-wrapper">

                <table class="axis-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Categoría</th>
                            <th>Estado</th>
                            <th class="axis-table-actions">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var categoria in Model)
                        {
                            <tr>

                                <td>
                                    <span class="axis-table-id">
                                        @categoria.IdCategoriaProducto.ToString("D3")
                                    </span>
                                </td>

                                <td>
                                    <strong class="axis-table-primary">
                                        @categoria.Nombre
                                    </strong>
                                </td>

                                <td>
                                    @if (categoria.Activo)
                                    {
                                        <span class="axis-status axis-status-active">
                                            ACTIVA
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="axis-status axis-status-inactive">
                                            INACTIVA
                                        </span>
                                    }
                                </td>

                                <td class="axis-table-actions">

                                    <a asp-action="DetalleCategoria"
                                       asp-route-id="@categoria.IdCategoriaProducto"
                                       class="axis-action">
                                        Ver
                                    </a>

                                    <a asp-action="EditarCategoria"
                                       asp-route-id="@categoria.IdCategoriaProducto"
                                       class="axis-action">
                                        Editar
                                    </a>

                                    <form asp-action="CambiarEstadoCategoria"
                                          method="post"
                                          class="axis-inline-form">

                                        <input type="hidden"
                                               name="id"
                                               value="@categoria.IdCategoriaProducto" />

                                        <input type="hidden"
                                               name="activo"
                                               value="@(!categoria.Activo)" />

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="axis-action axis-action-button">
                                            @(categoria.Activo ? "Desactivar" : "Activar")
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>