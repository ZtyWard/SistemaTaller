@model IEnumerable<Negocios.DTOs.NotificacionDto>

@{
    ViewData["Title"] = "Notificaciones";
    Layout = "~/Views/Shared/_InternalLayout.cshtml";

    var lista = Model?.ToList()
        ?? new List<Negocios.DTOs.NotificacionDto>();
}

@section Styles
{
    <style>
        .axis-notifications-page {
            max-width: 1100px;
            margin: 0 auto;
        }

        .axis-notifications-header {
            margin-bottom: 28px;
        }

        .axis-notifications-kicker {
            display: block;
            margin-bottom: 9px;
            color: #8f8a98;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 2.2px;
            text-transform: uppercase;
        }

        .axis-notifications-header h1 {
            margin: 0;
            color: #f3f1f7;
            font-size: 38px;
            font-weight: 650;
            letter-spacing: -1.5px;
        }

        .axis-notifications-header p {
            margin: 9px 0 0;
            color: #8d8992;
            font-size: 13px;
        }

        .axis-notifications-summary {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
        }

        .axis-notifications-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 32px;
            height: 28px;
            padding: 0 10px;
            border: 1px solid rgba(255,255,255,.10);
            border-radius: 999px;
            background: rgba(255,255,255,.05);
            color: #f3f1f7;
            font-size: 11px;
        }

        .axis-notifications-label {
            color: #77737c;
            font-size: 11px;
        }

        .axis-notifications-list {
            display: grid;
            gap: 12px;
        }

        .axis-notification-card {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 18px 20px;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            background:
                linear-gradient(
                    135deg,
                    rgba(255,255,255,.055),
                    rgba(255,255,255,.018)
                );
            box-shadow:
                0 18px 40px rgba(0,0,0,.12),
                inset 0 1px 0 rgba(255,255,255,.025);
            text-decoration: none;
            transition:
                transform .22s ease,
                border-color .22s ease,
                background .22s ease;
        }

        .axis-notification-card:hover {
            transform: translateY(-2px);
            border-color: rgba(255,255,255,.16);
            background:
                linear-gradient(
                    135deg,
                    rgba(255,255,255,.075),
                    rgba(255,255,255,.025)
                );
        }

        .axis-notification-icon {
            flex: 0 0 44px;
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 13px;
            background: rgba(255,255,255,.055);
            color: #e9e5ee;
            font-size: 17px;
        }

        .axis-notification-content {
            flex: 1;
            min-width: 0;
        }

        .axis-notification-title {
            display: block;
            margin-bottom: 4px;
            color: #f1eef5;
            font-size: 13px;
            font-weight: 600;
        }

        .axis-notification-message {
            display: block;
            color: #89858e;
            font-size: 11px;
            line-height: 1.55;
        }

        .axis-notification-arrow {
            color: #77727d;
            font-size: 16px;
            transition: transform .22s ease;
        }

        .axis-notification-card:hover
        .axis-notification-arrow {
            transform: translateX(3px);
        }

        .axis-notification-danger {
            border-color: rgba(196,125,143,.18);
        }

        .axis-notification-warning {
            border-color: rgba(190,164,111,.15);
        }

        .axis-notification-info {
            border-color: rgba(145,143,170,.13);
        }

        .axis-notifications-empty {
            padding: 55px 30px;
            text-align: center;
            border: 1px solid rgba(255,255,255,.07);
            border-radius: 18px;
            background: rgba(255,255,255,.025);
        }

        .axis-notifications-empty-icon {
            margin-bottom: 12px;
            color: #77727d;
            font-size: 28px;
        }

        .axis-notifications-empty h2 {
            margin: 0 0 7px;
            color: #eeeaf2;
            font-size: 17px;
            font-weight: 600;
        }

        .axis-notifications-empty p {
            margin: 0;
            color: #77727d;
            font-size: 12px;
        }

        @@media (max-width: 700px) {
            .axis-notifications-header h1 {
                font-size: 31px;
            }

            .axis-notification-card {
                padding: 15px;
            }
        }
    </style>
}

<div class="axis-notifications-page">

    <header class="axis-notifications-header">

        <span class="axis-notifications-kicker">
            CENTRO DE ALERTAS
        </span>

        <h1>
            Notificaciones
        </h1>

        <p>
            Alertas operativas generadas a partir del estado actual de AXIS.
        </p>

    </header>

    <div class="axis-notifications-summary">

        <span class="axis-notifications-count">
            @lista.Count
        </span>

        <span class="axis-notifications-label">
            alerta(s) activa(s)
        </span>

    </div>

    @if (!lista.Any())
    {
        <div class="axis-notifications-empty">

            <div class="axis-notifications-empty-icon">
                ◐
            </div>

            <h2>
                Todo está bajo control
            </h2>

            <p>
                No hay alertas operativas pendientes en este momento.
            </p>

        </div>
    }
    else
    {
        <div class="axis-notifications-list">

            @foreach (var notificacion in lista)
            {
                <a href="@notificacion.Url"
                   class="axis-notification-card axis-notification-@notificacion.Severidad">

                    <span class="axis-notification-icon">
                        @notificacion.Icono
                    </span>

                    <span class="axis-notification-content">

                        <span class="axis-notification-title">
                            @notificacion.Titulo
                        </span>

                        <span class="axis-notification-message">
                            @notificacion.Mensaje
                        </span>

                    </span>

                    <span class="axis-notification-arrow">
                        →
                    </span>

                </a>
            }

        </div>
    }

</div>