@model IEnumerable<Negocios.DTOs.EntregaDto>

@{
    ViewData["Title"] = "Entregas de vehículos";
    var totalEntregas = Model.Count();
}

@section Styles {
    <style>
        /* =========================================================
                   AXIS · ENTREGAS
                   ========================================================= */

        .axis-entregas {
            width: 100%;
            max-width: 1500px;
            margin: 0 auto;
            padding: 42px 48px 70px;
        }

        /* =========================================================
                   HEADER
                   ========================================================= */

        .axis-entregas-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 30px;
            margin-bottom: 34px;
        }

        .axis-entregas-eyebrow {
            display: block;
            margin-bottom: 10px;
            color: #73737c;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .22em;
            text-transform: uppercase;
        }

        .axis-entregas-title {
            margin: 0;
            color: #f4f4f7;
            font-size: clamp(34px, 4vw, 52px);
            font-weight: 750;
            letter-spacing: -.045em;
            line-height: 1;
        }

        .axis-entregas-description {
            margin: 14px 0 0;
            color: #85858e;
            font-size: 14px;
            line-height: 1.6;
        }

        /* =========================================================
                   BUTTONS
                   ========================================================= */

        .axis-entregas-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 46px;
            padding: 0 20px;
            border: 1px solid rgba(255,255,255,.72);
            border-radius: 11px;
            background: #f1edf4;
            color: #151519 !important;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none !important;
            box-shadow: 0 8px 25px rgba(0,0,0,.18);
            transition: .18s ease;
        }

            .axis-entregas-primary:hover {
                background: #ffffff;
                border-color: #ffffff;
                color: #111115 !important;
                transform: translateY(-1px);
                box-shadow: 0 10px 30px rgba(255,255,255,.08);
            }

        /* =========================================================
                   ALERTS
                   ========================================================= */

        .axis-entregas-alert {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 22px;
            padding: 14px 16px;
            border: 1px solid #2d2d34;
            border-radius: 13px;
            background: #151519;
            color: #d9d9df;
            font-size: 13px;
        }

        .axis-entregas-alert-success {
            border-color: rgba(83,150,106,.30);
            background: rgba(50,100,65,.08);
        }

        .axis-entregas-alert-danger {
            border-color: rgba(170,75,75,.30);
            background: rgba(120,40,40,.08);
        }

        .axis-entregas-alert button {
            filter: invert(1);
            opacity: .55;
        }

        /* =========================================================
                   SUMMARY
                   ========================================================= */

        .axis-entregas-summary {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 14px;
        }

        .axis-entregas-summary-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .axis-entregas-summary-label {
            color: #676770;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .15em;
            text-transform: uppercase;
        }

        .axis-entregas-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 29px;
            height: 24px;
            padding: 0 8px;
            border: 1px solid #34343b;
            border-radius: 999px;
            background: #19191e;
            color: #c4c4ca;
            font-size: 10px;
            font-weight: 750;
        }

        /* =========================================================
                   TABLE CARD
                   ========================================================= */

        .axis-entregas-card {
            overflow: hidden;
            border: 1px solid #29292f;
            border-radius: 18px;
            background: linear-gradient( 150deg, rgba(255,255,255,.035), rgba(255,255,255,.012) 45%, rgba(255,255,255,.018) );
            box-shadow: 0 22px 70px rgba(0,0,0,.20);
        }

        .axis-entregas-table-wrap {
            overflow-x: auto;
        }

        .axis-entregas-table {
            width: 100%;
            min-width: 1050px;
            border-collapse: collapse;
        }

            .axis-entregas-table thead th {
                padding: 14px 18px;
                border-bottom: 1px solid #29292f;
                background: rgba(255,255,255,.012);
                color: #64646d;
                font-size: 9px;
                font-weight: 800;
                letter-spacing: .15em;
                text-align: left;
                text-transform: uppercase;
                white-space: nowrap;
            }

            .axis-entregas-table tbody td {
                padding: 17px 18px;
                border-bottom: 1px solid #222228;
                color: #bfc0c7;
                font-size: 13px;
                vertical-align: middle;
            }

            .axis-entregas-table tbody tr {
                transition: background .18s ease;
            }

                .axis-entregas-table tbody tr:hover {
                    background: rgba(255,255,255,.018);
                }

                .axis-entregas-table tbody tr:last-child td {
                    border-bottom: 0;
                }

        /* =========================================================
                   OT
                   ========================================================= */

        .axis-entrega-ot {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .axis-entrega-ot-id {
            color: #e2e2e6;
            font-size: 13px;
            font-weight: 750;
        }

        .axis-entrega-ot-label {
            color: #65656d;
            font-size: 10px;
        }

        /* =========================================================
                   VEHICLE
                   ========================================================= */

        .axis-entrega-vehicle {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .axis-entrega-plate {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 76px;
            padding: 6px 10px;
            border: 1px solid #393940;
            border-radius: 7px;
            background: #17171b;
            color: #dedee2;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .08em;
        }

        /* =========================================================
                   CLIENT
                   ========================================================= */

        .axis-entrega-client {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 170px;
        }

        .axis-entrega-avatar {
            display: flex;
            flex: 0 0 auto;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border: 1px solid #35353d;
            border-radius: 50%;
            background: #1c1c21;
            color: #aaa9b1;
            font-size: 11px;
            font-weight: 750;
            text-transform: uppercase;
        }

        .axis-entrega-client-name {
            color: #d9d9de;
            font-weight: 600;
        }

        /* =========================================================
                   DATE
                   ========================================================= */

        .axis-entrega-date {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .axis-entrega-date-main {
            color: #cfcfd4;
            font-size: 12px;
            font-weight: 600;
        }

        .axis-entrega-date-time {
            color: #66666f;
            font-size: 10px;
        }

        /* =========================================================
                   RECEIVES
                   ========================================================= */

        .axis-entrega-receiver {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #c6c6cc;
            white-space: nowrap;
        }

        .axis-entrega-receiver-icon {
            color: #777780;
            font-size: 12px;
        }

        /* =========================================================
                   STATUS PILLS
                   ========================================================= */

        .axis-entrega-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 9px;
            border: 1px solid #34343a;
            border-radius: 999px;
            background: #18181c;
            color: #aeadb5;
            font-size: 10px;
            font-weight: 750;
            white-space: nowrap;
        }

            .axis-entrega-status::before {
                content: "";
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: #77777f;
            }

        .axis-entrega-paid {
            border-color: rgba(82,145,103,.28);
            color: #9ac4a6;
        }

            .axis-entrega-paid::before {
                background: #6ca77d;
            }

        .axis-entrega-partial {
            border-color: rgba(164,133,71,.30);
            color: #c9b47f;
        }

            .axis-entrega-partial::before {
                background: #c4a65e;
            }

        .axis-entrega-pending {
            border-color: rgba(165,72,72,.30);
            color: #d59b9b;
        }

            .axis-entrega-pending::before {
                background: #b86c6c;
            }

        .axis-entrega-info {
            border-color: rgba(82,123,150,.28);
            color: #9dbbd0;
        }

            .axis-entrega-info::before {
                background: #719dbb;
            }

        .axis-entrega-neutral {
            color: #898991;
        }

        /* =========================================================
                   ACCEPTANCE
                   ========================================================= */

        .axis-entrega-acceptance {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            font-weight: 650;
            white-space: nowrap;
        }

        .axis-entrega-acceptance-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

        .axis-entrega-accepted {
            color: #9ac4a6;
        }

            .axis-entrega-accepted .axis-entrega-acceptance-dot {
                background: #6ca77d;
            }

        .axis-entrega-not-accepted {
            color: #8b8b94;
        }

            .axis-entrega-not-accepted .axis-entrega-acceptance-dot {
                background: #66666f;
            }

        /* =========================================================
                   ACTIONS
                   ========================================================= */

        .axis-entrega-actions {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

        .axis-entrega-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            height: 32px;
            padding: 0 10px;
            border: 1px solid #303038;
            border-radius: 8px;
            background: #17171b;
            color: #aaaab2 !important;
            font-size: 11px;
            font-weight: 650;
            text-decoration: none !important;
            transition: .18s ease;
        }

            .axis-entrega-action:hover {
                border-color: #47474f;
                background: #222228;
                color: #f0f0f2 !important;
                transform: translateY(-1px);
            }

        /* =========================================================
                   EMPTY STATE
                   ========================================================= */

        .axis-entregas-empty {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 360px;
            padding: 45px 25px;
            text-align: center;
        }

        .axis-entregas-empty-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 60px;
            height: 60px;
            margin-bottom: 18px;
            border: 1px solid #303038;
            border-radius: 17px;
            background: #18181d;
            color: #777780;
            font-size: 23px;
        }

        .axis-entregas-empty-title {
            margin: 0;
            color: #dcdce1;
            font-size: 17px;
            font-weight: 700;
        }

        .axis-entregas-empty-description {
            max-width: 420px;
            margin: 9px 0 0;
            color: #686871;
            font-size: 13px;
            line-height: 1.6;
        }

        /* =========================================================
                   RESPONSIVE
                   ========================================================= */

        @@media (max-width: 900px) {

            .axis-entregas {
                padding: 30px 24px 55px;
            }

            .axis-entregas-header {
                align-items: flex-start;
                flex-direction: column;
            }
        }

        @@media (max-width: 600px) {

            .axis-entregas {
                padding: 25px 16px 45px;
            }

            .axis-entregas-title {
                font-size: 34px;
            }

            .axis-entregas-header .axis-entregas-primary {
                width: 100%;
            }

            .axis-entregas-summary {
                align-items: flex-start;
            }
        }
    </style>
}

<div class="axis-entregas">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <header class="axis-entregas-header">

        <div>

            <span class="axis-entregas-eyebrow">
                AXIS · ENTREGA
            </span>

            <h1 class="axis-entregas-title">
                Entregas
            </h1>

            <p class="axis-entregas-description">
                Registro y control de vehículos entregados.
            </p>

        </div>

        <a asp-action="Create"
           class="axis-entregas-primary">

            <span>＋</span>
            <span>Registrar entrega</span>

        </a>

    </header>


    <!-- =========================================================
         ALERTS
         ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="axis-entregas-alert axis-entregas-alert-success">

            <span>
                @TempData["Success"]
            </span>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="axis-entregas-alert axis-entregas-alert-danger">

            <span>
                @TempData["Error"]
            </span>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }


    <!-- =========================================================
         SUMMARY
         ========================================================= -->

    <div class="axis-entregas-summary">

        <div class="axis-entregas-summary-left">

            <span class="axis-entregas-summary-label">
                Entregas registradas
            </span>

            <span class="axis-entregas-count">
                @totalEntregas
            </span>

        </div>

    </div>


    <!-- =========================================================
         TABLE
         ========================================================= -->

    <section class="axis-entregas-card">

        @if (!Model.Any())
        {
            <div class="axis-entregas-empty">

                <div class="axis-entregas-empty-icon">
                    ◇
                </div>

                <h2 class="axis-entregas-empty-title">
                    No hay entregas registradas
                </h2>

                <p class="axis-entregas-empty-description">
                    Las entregas aparecerán aquí cuando se registre
                    la salida de un vehículo.
                </p>

            </div>
        }
        else
        {
            <div class="axis-entregas-table-wrap">

                <table class="axis-entregas-table">

                    <thead>

                        <tr>

                            <th>OT</th>
                            <th>Vehículo</th>
                            <th>Cliente</th>
                            <th>Fecha</th>
                            <th>Recibe</th>
                            <th>Pago</th>
                            <th>Garantía</th>
                            <th>Aceptación</th>
                            <th class="text-end">Acciones</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var entrega in Model)
                        {
                            var inicialCliente =
                            string.IsNullOrWhiteSpace(entrega.ClienteNombre)
                            ? "?"
                            : entrega.ClienteNombre
                            .Substring(0, 1)
                            .ToUpper();

                            <tr>

                                <!-- OT -->

                                <td>

                                    <div class="axis-entrega-ot">

                                        <span class="axis-entrega-ot-id">
                                            OT #@entrega.IdOrdenTrabajo
                                        </span>

                                        <span class="axis-entrega-ot-label">
                                            Orden de trabajo
                                        </span>

                                    </div>

                                </td>


                                <!-- VEHÍCULO -->

                                <td>

                                    <span class="axis-entrega-plate">
                                        @entrega.Placa
                                    </span>

                                </td>


                                <!-- CLIENTE -->

                                <td>

                                    <div class="axis-entrega-client">

                                        <span class="axis-entrega-avatar">
                                            @inicialCliente
                                        </span>

                                        <span class="axis-entrega-client-name">
                                            @entrega.ClienteNombre
                                        </span>

                                    </div>

                                </td>


                                <!-- FECHA -->

                                <td>

                                    <div class="axis-entrega-date">

                                        <span class="axis-entrega-date-main">
                                            @entrega.FechaEntrega.ToLocalTime().ToString("dd/MM/yyyy")
                                        </span>

                                        <span class="axis-entrega-date-time">
                                            @entrega.FechaEntrega.ToLocalTime().ToString("HH:mm")
                                        </span>

                                    </div>

                                </td>


                                <!-- RECIBE -->

                                <td>

                                    <div class="axis-entrega-receiver">

                                        <span class="axis-entrega-receiver-icon">
                                            ◉
                                        </span>

                                        <span>
                                            @entrega.PersonaRecibe
                                        </span>

                                    </div>

                                </td>


                                <!-- PAGO -->

                                <td>

                                    @if (entrega.EstadoPago == "Pagado")
                                    {
                                        <span class="axis-entrega-status axis-entrega-paid">
                                            Pagado
                                        </span>
                                    }
                                    else if (entrega.EstadoPago == "Parcial")
                                    {
                                        <span class="axis-entrega-status axis-entrega-partial">
                                            Parcial
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="axis-entrega-status axis-entrega-pending">
                                            Pendiente
                                        </span>
                                    }

                                </td>


                                <!-- GARANTÍA -->

                                <td>

                                    @if (entrega.TieneGarantia)
                                    {
                                        <span class="axis-entrega-status axis-entrega-info">
                                            Sí
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="axis-entrega-status axis-entrega-neutral">
                                            No
                                        </span>
                                    }

                                </td>


                                <!-- ACEPTACIÓN -->

                                <td>

                                    @if (entrega.Aceptacion)
                                    {
                                        <span class="axis-entrega-acceptance axis-entrega-accepted">

                                            <span class="axis-entrega-acceptance-dot"></span>

                                            Aceptada

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="axis-entrega-acceptance axis-entrega-not-accepted">

                                            <span class="axis-entrega-acceptance-dot"></span>

                                            Pendiente

                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="axis-entrega-actions">

                                        <a asp-action="Details"
                                           asp-route-id="@entrega.IdEntrega"
                                           class="axis-entrega-action">

                                            Ver

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@entrega.IdEntrega"
                                           class="axis-entrega-action">

                                            Editar

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>