@model IEnumerable<Negocios.DTOs.EntregaDto>

@{
    ViewData["Title"] = "Entregas de vehículos";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <span class="text-muted small fw-bold">
                AXIS · ENTREGA
            </span>

            <h1 class="fw-bold mb-1">
                Entregas de vehículos
            </h1>

            <p class="text-muted mb-0">
                Registro y control de vehículos entregados.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-box-arrow-right me-1"></i>

            Registrar entrega

        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-car-front display-4 text-muted"></i>

                    <h5 class="mt-3">
                        No hay entregas registradas
                    </h5>

                    <p class="text-muted">
                        Las entregas aparecerán aquí cuando se registre
                        la salida de un vehículo.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    OT
                                </th>

                                <th>
                                    Vehículo
                                </th>

                                <th>
                                    Cliente
                                </th>

                                <th>
                                    Fecha
                                </th>

                                <th>
                                    Recibe
                                </th>

                                <th>
                                    Pago
                                </th>

                                <th>
                                    Garantía
                                </th>

                                <th>
                                    Aceptación
                                </th>

                                <th class="text-end">
                                    Acciones
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var entrega in Model)
                            {
                                <tr>

                                    <td>
                                        <span class="fw-semibold">
                                            OT #@entrega.IdOrdenTrabajo
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge text-bg-dark">
                                            @entrega.Placa
                                        </span>
                                    </td>

                                    <td>
                                        @entrega.ClienteNombre
                                    </td>

                                    <td>
                                        @entrega.FechaEntrega.ToLocalTime()
                                    </td>

                                    <td>
                                        @entrega.PersonaRecibe
                                    </td>

                                    <td>

                                        @if (entrega.EstadoPago == "Pagado")
                                        {
                                            <span class="badge text-bg-success">
                                                Pagado
                                            </span>
                                        }
                                        else if (entrega.EstadoPago == "Parcial")
                                        {
                                            <span class="badge text-bg-warning">
                                                Parcial
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-danger">
                                                Pendiente
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (entrega.TieneGarantia)
                                        {
                                            <span class="badge text-bg-info">
                                                Sí
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (entrega.Aceptacion)
                                        {
                                            <span class="badge text-bg-success">
                                                Aceptada
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">
                                                Pendiente
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-id="@entrega.IdEntrega"
                                               class="btn btn-sm btn-outline-secondary">

                                                <i class="bi bi-eye"></i>

                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@entrega.IdEntrega"
                                               class="btn btn-sm btn-outline-primary">

                                                <i class="bi bi-pencil"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>