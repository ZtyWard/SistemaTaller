@model Negocios.DTOs.EntregaGuardarDto

@{
    ViewData["Title"] = "Registrar entrega";

    var ordenes =
        ViewBag.OrdenesFinalizadas as IEnumerable<Negocios.DTOs.OrdenTrabajoDto>
        ?? Enumerable.Empty<Negocios.DTOs.OrdenTrabajoDto>();
}

<div class="axis-page axis-modern-page">

    <div class="axis-page-header axis-modern-header">

        <div>

            <span class="axis-page-kicker">
                AXIS · ENTREGA
            </span>

            <h1>
                Registrar entrega
            </h1>

            <p>
                Registra la salida del vehículo del taller.
            </p>

        </div>


        <div class="axis-page-actions">

            <a asp-action="Index"
               class="axis-button axis-button-secondary">

                <i class="bi bi-arrow-left"></i>

                Volver

            </a>

        </div>

    </div>


    <div class="axis-form-card axis-modern-card">

        <form asp-action="Create"
              method="post"
              class="axis-form axis-modern-form">

            @Html.AntiForgeryToken()


            <div asp-validation-summary="ModelOnly"
                 class="axis-form-validation">
            </div>


            <!-- ================================================= -->
            <!-- SALIDA -->
            <!-- ================================================= -->

            <section class="axis-form-section axis-modern-section">

                <div class="axis-form-section-title">
                    Salida del vehículo
                </div>


                <div class="axis-form-grid">

                    <div class="axis-field">

                        <label asp-for="IdOrdenTrabajo">
                            Orden de trabajo
                        </label>

                        <select asp-for="IdOrdenTrabajo">

                            <option value="">
                                Seleccione una OT finalizada
                            </option>

                            @foreach (var orden in ordenes)
                            {
                                <option value="@orden.IdOrdenTrabajo">

                                    OT #@orden.IdOrdenTrabajo
                                    —
                                    @orden.Placa
                                    —
                                    @orden.ClienteNombre

                                </option>
                            }

                        </select>

                        <small>
                            Solo aparecen órdenes finalizadas
                            y sin una entrega registrada.
                        </small>

                        <span asp-validation-for="IdOrdenTrabajo"></span>

                    </div>


                    <div class="axis-field">

                        <label asp-for="KilometrajeSalida">
                            Kilometraje de salida
                        </label>

                        <input asp-for="KilometrajeSalida"
                               type="number"
                               min="0"
                               placeholder="Ej. 85420" />

                        <span asp-validation-for="KilometrajeSalida"></span>

                    </div>


                    <div class="axis-field">

                        <label asp-for="PersonaRecibe">
                            Persona que recibe
                        </label>

                        <input asp-for="PersonaRecibe"
                               placeholder="Nombre completo" />

                        <span asp-validation-for="PersonaRecibe"></span>

                    </div>


                    <div class="axis-field">

                        <label asp-for="EstadoPago">
                            Estado de pago
                        </label>

                        <select asp-for="EstadoPago">

                            <option value="Pendiente">
                                Pendiente
                            </option>

                            <option value="Parcial">
                                Parcial
                            </option>

                            <option value="Pagado">
                                Pagado
                            </option>

                        </select>

                        <span asp-validation-for="EstadoPago"></span>

                    </div>

                </div>

            </section>


            <!-- ================================================= -->
            <!-- CONFIRMACIÓN -->
            <!-- ================================================= -->

            <section class="axis-form-section axis-modern-section">

                <div class="axis-form-section-title">
                    Confirmación
                </div>


                <div class="axis-form-grid">


                    <div class="axis-field">

                        <div class="axis-modern-switch">

                            <input asp-for="TieneGarantia"
                                   type="checkbox"
                                   id="TieneGarantia" />

                            <label asp-for="TieneGarantia">

                                <strong>
                                    El servicio tiene garantía
                                </strong>

                                <small>
                                    Indica si la entrega queda
                                    cubierta por garantía.
                                </small>

                            </label>

                        </div>

                    </div>


                    <div class="axis-field">

                        <div class="axis-modern-switch">

                            <input asp-for="Aceptacion"
                                   type="checkbox"
                                   id="Aceptacion" />

                            <label asp-for="Aceptacion">

                                <strong>
                                    Cliente acepta la entrega
                                </strong>

                                <small>
                                    Al aceptar, se solicita
                                    el nombre de quien recibe.
                                </small>

                            </label>

                        </div>

                    </div>


                    <div class="axis-field"
                         id="firmaContainer">

                        <label asp-for="FirmaNombre">
                            Nombre de quien acepta
                        </label>

                        <input asp-for="FirmaNombre"
                               placeholder="Nombre completo" />

                        <span asp-validation-for="FirmaNombre"></span>

                    </div>


                    <div class="axis-field axis-field-full">

                        <label asp-for="Observaciones">
                            Observaciones
                        </label>

                        <textarea asp-for="Observaciones"
                                  rows="4"
                                  placeholder="Estado del vehículo al momento de la entrega...">
                        </textarea>

                        <span asp-validation-for="Observaciones"></span>

                    </div>


                    <div class="axis-field axis-field-full">

                        <label asp-for="Recomendaciones">
                            Recomendaciones
                        </label>

                        <textarea asp-for="Recomendaciones"
                                  rows="4"
                                  placeholder="Mantenimientos o recomendaciones para el cliente...">
                        </textarea>

                        <span asp-validation-for="Recomendaciones"></span>

                    </div>

                </div>

            </section>


            <div class="axis-form-actions axis-modern-actions">

                <a asp-action="Index"
                   class="axis-button axis-button-secondary">

                    Cancelar

                </a>

                <button type="submit"
                        class="axis-button axis-button-primary">

                    <i class="bi bi-check-lg"></i>

                    Registrar entrega

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const aceptacion =
                    document.getElementById("Aceptacion");

                const firmaContainer =
                    document.getElementById("firmaContainer");


                function actualizarFirma() {

                    if (
                        !aceptacion ||
                        !firmaContainer
                    )
                        return;

                    firmaContainer.style.display =
                        aceptacion.checked
                            ? ""
                            : "none";

                }


                aceptacion?.addEventListener(
                    "change",
                    actualizarFirma
                );

                actualizarFirma();

            }
        );

    </script>

}