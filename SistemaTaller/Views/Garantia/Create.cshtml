@model Negocios.DTOs.GarantiaGuardarDto

@{
    ViewData["Title"] = "Nueva garantía";
}

<div class="axis-page axis-modern-page">

    <div class="axis-page-header axis-modern-header">

        <div>

            <span class="axis-page-kicker">
                AXIS · GARANTÍAS
            </span>

            <h1>
                Nueva garantía
            </h1>

            <p>
                Registra una garantía para un servicio o producto.
            </p>

        </div>


        <div class="axis-page-actions">

            <a asp-action="Index"
               class="axis-button axis-button-secondary">

                <i class="bi bi-arrow-left"></i>

                Volver

            </a>

        </div>

    </div>


    <div class="axis-form-card axis-modern-card">

        <form asp-action="Create"
              method="post"
              class="axis-form axis-modern-form">

            @Html.AntiForgeryToken()


            <div asp-validation-summary="ModelOnly"
                 class="axis-form-validation">
            </div>


            <!-- ORIGEN -->

            <section class="axis-form-section axis-modern-section">

                <div class="axis-form-section-title">
                    Origen de la garantía
                </div>


                <div class="axis-modern-note">

                    <i class="bi bi-info-circle"></i>

                    <span>
                        La garantía debe estar asociada
                        a una orden de trabajo o a una venta.
                    </span>

                </div>


                <div class="axis-form-grid">

                    <div class="axis-field">

                        <label asp-for="IdOrdenTrabajo">
                            Orden de trabajo
                        </label>

                        <input asp-for="IdOrdenTrabajo"
                               type="number"
                               min="1"
                               placeholder="Ej. 1" />

                        <small>
                            Indica la OT que originó la garantía.
                        </small>

                        <span asp-validation-for="IdOrdenTrabajo"></span>

                    </div>


                    <div class="axis-field">

                        <label asp-for="IdVenta">
                            Venta
                        </label>

                        <input asp-for="IdVenta"
                               type="number"
                               min="1"
                               placeholder="Ej. 1" />

                        <small>
                            Alternativamente puedes indicar una venta.
                        </small>

                        <span asp-validation-for="IdVenta"></span>

                    </div>

                </div>

            </section>


            <!-- COBERTURA -->

            <section class="axis-form-section axis-modern-section">

                <div class="axis-form-section-title">
                    Cobertura
                </div>


                <div class="axis-modern-note axis-modern-note-warning">

                    <i class="bi bi-exclamation-triangle"></i>

                    <span>
                        La garantía debe cubrir un producto
                        o un servicio, no ambos.
                    </span>

                </div>


                <div class="axis-form-grid">

                    <div class="axis-field">

                        <label asp-for="IdServicio">
                            Servicio
                        </label>

                        <input asp-for="IdServicio"
                               type="number"
                               min="1"
                               placeholder="Ej. 1" />

                        <small>
                            Utiliza este campo si corresponde
                            a un servicio.
                        </small>

                        <span asp-validation-for="IdServicio"></span>

                    </div>


                    <div class="axis-field">

                        <label asp-for="IdProducto">
                            Producto / repuesto
                        </label>

                        <input asp-for="IdProducto"
                               type="number"
                               min="1"
                               placeholder="Ej. 1" />

                        <small>
                            Utiliza este campo si corresponde
                            a un producto.
                        </small>

                        <span asp-validation-for="IdProducto"></span>

                    </div>

                </div>

            </section>


            <!-- VIGENCIA -->

            <section class="axis-form-section axis-modern-section">

                <div class="axis-form-section-title">
                    Vigencia
                </div>


                <div class="axis-form-grid">

                    <div class="axis-field">

                        <label asp-for="FechaInicio">
                            Fecha de inicio
                        </label>

                        <input asp-for="FechaInicio"
                               type="date" />

                        <span asp-validation-for="FechaInicio"></span>

                    </div>


                    <div class="axis-field">

                        <label asp-for="FechaVencimiento">
                            Fecha de vencimiento
                        </label>

                        <input asp-for="FechaVencimiento"
                               type="date" />

                        <span asp-validation-for="FechaVencimiento"></span>

                    </div>


                    <div class="axis-field axis-field-full">

                        <label asp-for="Condiciones">
                            Condiciones de garantía
                        </label>

                        <textarea asp-for="Condiciones"
                                  rows="4"
                                  placeholder="Condiciones aplicables a la garantía...">
                        </textarea>

                    </div>


                    <div class="axis-field axis-field-full">

                        <label asp-for="Observaciones">
                            Observaciones
                        </label>

                        <textarea asp-for="Observaciones"
                                  rows="4"
                                  placeholder="Observaciones adicionales...">
                        </textarea>

                    </div>

                </div>

            </section>


            <div class="axis-form-actions axis-modern-actions">

                <a asp-action="Index"
                   class="axis-button axis-button-secondary">

                    Cancelar

                </a>

                <button type="submit"
                        class="axis-button axis-button-primary">

                    <i class="bi bi-shield-check"></i>

                    Registrar garantía

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}