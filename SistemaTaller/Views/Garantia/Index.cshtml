@model IEnumerable<Negocios.DTOs.GarantiaDto>

@{
    ViewData["Title"] = "Garantías";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Garantías</h1>
            <p class="text-muted mb-0">
                Administración y seguimiento de garantías del taller.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="PorVencer"
               asp-route-dias="30"
               class="btn btn-outline-warning">
                Por vencer
            </a>

            <a asp-action="Create"
               class="btn btn-primary">
                Nueva garantía
            </a>

        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">

                    <h4>No hay garantías registradas</h4>

                    <p class="text-muted">
                        Todavía no existen garantías para mostrar.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        Registrar garantía
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Origen</th>
                                <th>Cobertura</th>
                                <th>Inicio</th>
                                <th>Vencimiento</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var garantia in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            #@garantia.IdGarantia
                                        </strong>
                                    </td>

                                    <td>

                                        @if (garantia.IdOrdenTrabajo.HasValue)
                                        {
                                            <span class="badge bg-secondary">
                                                OT #@garantia.IdOrdenTrabajo
                                            </span>
                                        }

                                        @if (garantia.IdVenta.HasValue)
                                        {
                                            <span class="badge bg-info text-dark">
                                                Venta #@garantia.IdVenta
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (garantia.IdProducto.HasValue)
                                        {
                                            <div>
                                                <strong>Producto</strong>
                                            </div>

                                            <small class="text-muted">
                                                @(garantia.ProductoNombre
                                                                                    ?? $"Producto #{garantia.IdProducto}")
                                </small>
                                                                }
                                        else if (garantia.IdServicio.HasValue)
                                        {
                                            <div>
                                                <strong>Servicio</strong>
                                            </div>

                                            <small class="text-muted">
                                                @(garantia.ServicioNombre
                                                                                    ?? $"Servicio #{garantia.IdServicio}")
                                </small>
                                                                }

                                    </td>

                                    <td>
                                        @garantia.FechaInicio.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @garantia.FechaVencimiento.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>

                                        @switch (garantia.Estado)
                                        {
                                            case "Vigente":
                                                <span class="badge bg-success">
                                                    Vigente
                                                </span>
                                                break;

                                            case "Vencida":
                                                <span class="badge bg-danger">
                                                    Vencida
                                                </span>
                                                break;

                                            case "Reclamada":
                                                <span class="badge bg-warning text-dark">
                                                    Reclamada
                                                </span>
                                                break;

                                            case "Resuelta":
                                                <span class="badge bg-primary">
                                                    Resuelta
                                                </span>
                                                break;

                                            case "Rechazada":
                                                <span class="badge bg-dark">
                                                    Rechazada
                                                </span>
                                                break;

                                            default:
                                                <span class="badge bg-secondary">
                                                    @garantia.Estado
                                                </span>
                                                break;
                                        }

                                    </td>

                                    <td class="text-end">

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-id="@garantia.IdGarantia"
                                               class="btn btn-sm btn-outline-primary">
                                                Ver
                                            </a>

                                            @if (
                                                                                garantia.Estado == "Vigente")
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@garantia.IdGarantia"
                                                   class="btn btn-sm btn-outline-secondary">
                                                    Editar
                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>