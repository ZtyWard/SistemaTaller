@model IEnumerable<Negocios.DTOs.CitaDto>

@{
    ViewData["Title"] = "Agenda de citas";

    DateTime fechaSeleccionada =
        ViewBag.FechaSeleccionada ?? DateTime.Today;
}

<div class="container-fluid py-4">

    <!-- HEADER -->

    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">

        <div>
            <span class="text-muted small fw-bold">
                AXIS · AGENDA
            </span>

            <h1 class="fw-bold mb-1">
                Citas
            </h1>

            <p class="text-muted mb-0">
                Agenda y programación del taller.
            </p>
        </div>

        @if (User.HasClaim(
                "Permiso",
                Negocios.Seguridad.Permisos.CitasCrear))
        {
            <a asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-calendar-plus me-1"></i>
                Nueva cita
            </a>
        }

    </div>


    <!-- MENSAJES -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <!-- FILTRO DE FECHA -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        Fecha
                    </label>

                    <input type="date"
                           name="fecha"
                           value="@fechaSeleccionada.ToString("yyyy-MM-dd")"
                           class="form-control" />

                </div>

                <div class="col-auto">

                    <button type="submit"
                            class="btn btn-outline-primary">

                        <i class="bi bi-search me-1"></i>
                        Consultar

                    </button>

                </div>

                <div class="col-auto">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Hoy

                    </a>

                </div>

            </form>

        </div>

    </div>


    <!-- AGENDA -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-transparent
                    border-0 pt-4 px-4">

            <div class="d-flex justify-content-between
                        align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        Agenda del @fechaSeleccionada.ToString("dd/MM/yyyy")
                    </h5>

                    <small class="text-muted">
                        @Model.Count() cita(s) programada(s)
                    </small>

                </div>

                <i class="bi bi-calendar3 fs-4 text-muted"></i>

            </div>

        </div>


        <div class="card-body px-4">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>
                                    Hora
                                </th>

                                <th>
                                    Cliente
                                </th>

                                <th>
                                    Vehículo
                                </th>

                                <th>
                                    Servicio
                                </th>

                                <th>
                                    Mecánico / Área
                                </th>

                                <th>
                                    Estado
                                </th>

                                <th class="text-end">
                                    Acciones
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var cita in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @cita.FechaInicio.ToString("HH:mm")
                                        </strong>

                                        <small class="text-muted d-block">
                                            @cita.FechaFin.ToString("HH:mm")
                                        </small>
                                    </td>


                                    <td>

                                        <strong>
                                            @cita.ClienteNombre
                                        </strong>

                                    </td>


                                    <td>

                                        <span class="badge bg-light
                                                         text-dark border">
                                            @cita.VehiculoPlaca
                                        </span>

                                    </td>


                                    <td>
                                        @cita.ServicioNombre
                                    </td>


                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(
                                                                        cita.EmpleadoNombre))
                                        {
                                            <div>
                                                <i class="bi bi-person-gear me-1"></i>
                                                @cita.EmpleadoNombre
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(
                                                                        cita.Area))
                                        {
                                            <div class="text-muted small">
                                                <i class="bi bi-building me-1"></i>
                                                @cita.Area
                                            </div>
                                        }

                                    </td>


                                    <td>

                                        @switch (cita.Estado)
                                        {
                                            case "Programada":
                                                <span class="badge bg-primary">
                                                    Programada
                                                </span>
                                                break;

                                            case "Confirmada":
                                                <span class="badge bg-success">
                                                    Confirmada
                                                </span>
                                                break;

                                            case "En espera":
                                                <span class="badge bg-warning text-dark">
                                                    En espera
                                                </span>
                                                break;

                                            case "Atendida":
                                                <span class="badge bg-info text-dark">
                                                    Atendida
                                                </span>
                                                break;

                                            case "Cancelada":
                                                <span class="badge bg-danger">
                                                    Cancelada
                                                </span>
                                                break;

                                            case "No asistió":
                                                <span class="badge bg-secondary">
                                                    No asistió
                                                </span>
                                                break;

                                            default:
                                                <span class="badge bg-secondary">
                                                    @cita.Estado
                                                </span>
                                                break;
                                        }

                                    </td>


                                    <td class="text-end">

                                        <div class="btn-group">

                                            @if (User.HasClaim(
                                                                                "Permiso",
                                                                                Negocios.Seguridad.Permisos.CitasEditar))
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@cita.IdCita"
                                                   class="btn btn-sm
                                                                  btn-outline-primary">

                                                    Editar

                                                </a>
                                            }

                                            @if (
                                                                                cita.Estado != "Cancelada"
                                                                                &&
                                                                                User.HasClaim(
                                                                                "Permiso",
                                                                                Negocios.Seguridad.Permisos.CitasCancelar))
                                            {
                                                <form asp-action="Cancelar"
                                                      asp-route-id="@cita.IdCita"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm
                                                                           btn-outline-danger"
                                                            onclick="return confirm('¿Desea cancelar esta cita?');">

                                                        Cancelar

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-calendar-x fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No hay citas para esta fecha
                    </h5>

                    <p class="text-muted">
                        No existen citas programadas para el día seleccionado.
                    </p>

                    @if (User.HasClaim(
                                    "Permiso",
                                    Negocios.Seguridad.Permisos.CitasCrear))
                    {
                        <a asp-action="Create"
                           class="btn btn-primary">

                            <i class="bi bi-calendar-plus me-1"></i>
                            Crear cita

                        </a>
                    }

                </div>
            }

        </div>

    </div>

</div>