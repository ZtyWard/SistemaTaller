@model Negocios.DTOs.CitaFormularioDto

@{
    ViewData["Title"] = "Nueva cita";

    var clientes =
        ViewBag.Clientes as IEnumerable<Negocios.DTOs.ClienteDto>
        ?? Enumerable.Empty<Negocios.DTOs.ClienteDto>();

    var vehiculos =
        ViewBag.Vehiculos as IEnumerable<Negocios.DTOs.VehiculoDto>
        ?? Enumerable.Empty<Negocios.DTOs.VehiculoDto>();

    var servicios =
        ViewBag.Servicios as IEnumerable<Negocios.DTOs.ServicioDto>
        ?? Enumerable.Empty<Negocios.DTOs.ServicioDto>();

    var empleados =
        ViewBag.Empleados as IEnumerable<Negocios.DTOs.EmpleadoDto>
        ?? Enumerable.Empty<Negocios.DTOs.EmpleadoDto>();

    var estados =
        ViewBag.Estados as IEnumerable<string>
        ?? Enumerable.Empty<string>();
}

<div class="axis-page axis-modern-page">

    <div class="axis-page-header axis-modern-header">

        <div>
            <span class="axis-page-kicker">
                AXIS · AGENDA
            </span>

            <h1>Nueva cita</h1>

            <p>
                Programa una nueva atención para el taller.
            </p>
        </div>

        <div class="axis-page-actions">

            <a asp-action="Index"
               class="axis-button axis-button-secondary">

                <i class="bi bi-arrow-left"></i>

                Volver

            </a>

        </div>

    </div>


    <div class="axis-form-card axis-modern-card">

        <form asp-action="Create"
              method="post"
              class="axis-form axis-modern-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="axis-form-validation">
            </div>


            <!-- ================================================= -->
            <!-- INFORMACIÓN DE LA CITA -->
            <!-- ================================================= -->

            <section class="axis-form-section axis-modern-section">

                <div class="axis-form-section-title">
                    Información de la cita
                </div>


                <div class="axis-form-grid">

                    <!-- CLIENTE -->

                    <div class="axis-field">

                        <label asp-for="IdCliente">
                            Cliente
                        </label>

                        <select asp-for="IdCliente"
                                id="IdCliente">

                            <option value="">
                                Seleccione un cliente
                            </option>

                            @foreach (var cliente in clientes)
                            {
                                <option value="@cliente.IdCliente">

                                    @cliente.Nombre
                                    @cliente.Apellido1
                                    @cliente.Apellido2
                                    —
                                    @cliente.Cedula

                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdCliente"></span>

                    </div>


                    <!-- VEHÍCULO -->

                    <div class="axis-field">

                        <label asp-for="IdVehiculo">
                            Vehículo
                        </label>

                        <select asp-for="IdVehiculo"
                                id="IdVehiculo">

                            <option value="">
                                Seleccione un vehículo
                            </option>

                            @foreach (var vehiculo in vehiculos)
                            {
                                <option value="@vehiculo.IdVehiculo"
                                        data-cliente="@vehiculo.IdCliente">

                                    @vehiculo.Placa
                                    —
                                    @vehiculo.MarcaNombre
                                    @vehiculo.ModeloNombre

                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdVehiculo"></span>

                    </div>


                    <!-- SERVICIO -->

                    <div class="axis-field">

                        <label asp-for="IdServicio">
                            Servicio
                        </label>

                        <select asp-for="IdServicio"
                                id="IdServicio">

                            <option value=""
                                    data-duracion="0">

                                Seleccione un servicio

                            </option>

                            @foreach (var servicio in servicios)
                            {
                                <option value="@servicio.IdServicio"
                                        data-duracion="@(servicio.DuracionEstimada ?? 0)">

                                    @servicio.Nombre

                                    @if (servicio.DuracionEstimada.HasValue)
                                    {
                                        <text>
                                            — @servicio.DuracionEstimada min
                                        </text>
                                    }

                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdServicio"></span>

                    </div>


                    <!-- MECÁNICO -->

                    <div class="axis-field">

                        <label asp-for="IdEmpleado">
                            Mecánico
                        </label>

                        <select asp-for="IdEmpleado">

                            <option value="">
                                Sin mecánico específico
                            </option>

                            @foreach (var empleado in empleados)
                            {
                                <option value="@empleado.IdEmpleado">

                                    @empleado.NombreCompleto

                                    @if (!string.IsNullOrWhiteSpace(empleado.Especialidad))
                                    {
                                        <text>
                                            — @empleado.Especialidad
                                        </text>
                                    }

                                </option>
                            }

                        </select>

                        <small>
                            Puede asignarse un mecánico,
                            un área o ambos.
                        </small>

                    </div>


                    <!-- ÁREA -->

                    <div class="axis-field">

                        <label asp-for="Area">
                            Área
                        </label>

                        <select asp-for="Area">

                            <option value="">
                                Sin área específica
                            </option>

                            <option value="Diagnóstico">
                                Diagnóstico
                            </option>

                            <option value="Mecánica general">
                                Mecánica general
                            </option>

                            <option value="Electricidad">
                                Electricidad
                            </option>

                            <option value="Aire acondicionado">
                                Aire acondicionado
                            </option>

                            <option value="Suspensión y frenos">
                                Suspensión y frenos
                            </option>

                            <option value="Enderezado y pintura">
                                Enderezado y pintura
                            </option>

                            <option value="Lavado y detallado">
                                Lavado y detallado
                            </option>

                        </select>

                    </div>


                    <!-- ESTADO -->

                    <div class="axis-field">

                        <label asp-for="Estado">
                            Estado
                        </label>

                        <select asp-for="Estado">

                            @foreach (var estado in estados)
                            {
                                <option value="@estado">
                                    @estado
                                </option>
                            }

                        </select>

                    </div>

                </div>

            </section>


            <!-- ================================================= -->
            <!-- PROGRAMACIÓN -->
            <!-- ================================================= -->

            <section class="axis-form-section axis-modern-section">

                <div class="axis-form-section-title">
                    Programación
                </div>


                <div class="axis-form-grid">

                    <div class="axis-field">

                        <label asp-for="FechaInicio">
                            Fecha y hora de inicio
                        </label>

                        <input asp-for="FechaInicio"
                               type="datetime-local"
                               id="FechaInicio" />

                        <span asp-validation-for="FechaInicio"></span>

                    </div>


                    <div class="axis-field">

                        <label asp-for="FechaFin">
                            Fecha y hora de finalización
                        </label>

                        <input asp-for="FechaFin"
                               type="datetime-local"
                               id="FechaFin"
                               readonly />

                        <small>
                            Se calcula automáticamente
                            según la duración del servicio.
                        </small>

                        <span asp-validation-for="FechaFin"></span>

                    </div>


                    <div class="axis-field axis-field-full">

                        <label asp-for="Observaciones">
                            Observaciones
                        </label>

                        <textarea asp-for="Observaciones"
                                  rows="4"
                                  placeholder="Detalles relevantes de la cita...">
                        </textarea>

                        <span asp-validation-for="Observaciones"></span>

                    </div>

                </div>

            </section>


            <!-- ================================================= -->
            <!-- BOTONES -->
            <!-- ================================================= -->

            <div class="axis-form-actions axis-modern-actions">

                <a asp-action="Index"
                   class="axis-button axis-button-secondary">

                    Cancelar

                </a>

                <button type="submit"
                        class="axis-button axis-button-primary">

                    <i class="bi bi-calendar-check"></i>

                    Crear cita

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const cliente =
                    document.getElementById("IdCliente");

                const vehiculo =
                    document.getElementById("IdVehiculo");

                const servicio =
                    document.getElementById("IdServicio");

                const fechaInicio =
                    document.getElementById("FechaInicio");

                const fechaFin =
                    document.getElementById("FechaFin");


                function filtrarVehiculos() {

                    const clienteId =
                        cliente.value;

                    vehiculo
                        .querySelectorAll("option")
                        .forEach(function (opcion) {

                            if (!opcion.value)
                                return;

                            const visible =
                                !clienteId ||
                                opcion.dataset.cliente === clienteId;

                            opcion.hidden =
                                !visible;

                            if (
                                !visible &&
                                opcion.selected
                            ) {

                                vehiculo.value = "";

                            }

                        });

                }


                function calcularFechaFin() {

                    if (
                        !servicio ||
                        !fechaInicio ||
                        !fechaFin
                    )
                        return;


                    const opcion =
                        servicio.options[
                            servicio.selectedIndex
                        ];


                    if (
                        !opcion ||
                        !opcion.value
                    ) {

                        fechaFin.value = "";

                        return;

                    }


                    const duracion =
                        parseInt(
                            opcion.dataset.duracion || "0",
                            10
                        );


                    if (
                        !duracion ||
                        !fechaInicio.value
                    ) {

                        fechaFin.value = "";

                        return;

                    }


                    const inicio =
                        new Date(
                            fechaInicio.value
                        );


                    if (
                        isNaN(
                            inicio.getTime()
                        )
                    ) {

                        fechaFin.value = "";

                        return;

                    }


                    const fin =
                        new Date(
                            inicio.getTime() +
                            duracion * 60000
                        );


                    const year =
                        fin.getFullYear();

                    const month =
                        String(
                            fin.getMonth() + 1
                        ).padStart(2, "0");

                    const day =
                        String(
                            fin.getDate()
                        ).padStart(2, "0");

                    const hours =
                        String(
                            fin.getHours()
                        ).padStart(2, "0");

                    const minutes =
                        String(
                            fin.getMinutes()
                        ).padStart(2, "0");


                    fechaFin.value =
                        `${year}-${month}-${day}T${hours}:${minutes}`;

                }


                cliente?.addEventListener(
                    "change",
                    filtrarVehiculos
                );

                servicio?.addEventListener(
                    "change",
                    calcularFechaFin
                );

                fechaInicio?.addEventListener(
                    "change",
                    calcularFechaFin
                );

                fechaInicio?.addEventListener(
                    "input",
                    calcularFechaFin
                );


                filtrarVehiculos();

                calcularFechaFin();

            }
        );

    </script>

}