@{
    ViewData["Title"] = "Acceso denegado";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Acceso denegado - AXIS</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: #101014;
            color: #ffffff;
            font-family: Arial, Helvetica, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .container {
            width: 90%;
            max-width: 520px;
            text-align: center;
            padding: 45px 35px;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 22px;
            background: #17171c;
            box-shadow: 0 20px 60px rgba(0,0,0,.45);
        }

        .icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 25px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(220, 38, 38, .12);
            border: 1px solid rgba(220, 38, 38, .25);
            color: #ef4444;
            font-size: 38px;
        }

        h1 {
            margin: 0 0 15px;
            font-size: 30px;
        }

        p {
            color: #9a9aa3;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;
            padding: 13px 25px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,.15);
            color: white;
            text-decoration: none;
            transition: .2s;
        }

        .btn:hover {
            background: rgba(255,255,255,.08);
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="icon">
            🔒
        </div>

        <h1>Acceso denegado</h1>

        <p>
            No tienes los permisos necesarios para acceder
            a este módulo del sistema.
        </p>

        <a href="/" class="btn">
            Volver al inicio
        </a>

    </div>

</body>
</html>