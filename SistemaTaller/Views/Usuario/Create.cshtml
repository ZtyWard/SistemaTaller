@model Negocios.DTOs.UsuarioGuardarDto

@{
    ViewData["Title"] = "Nuevo usuario";
    var roles = ViewBag.Roles as IEnumerable<string>
                 ?? Enumerable.Empty<string>();
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="fw-bold">Nuevo usuario</h1>
        <p class="text-muted">
            Registra un nuevo usuario para acceder a AXIS.
        </p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="NombreCompleto"
                               class="form-label">
                        </label>

                        <input asp-for="NombreCompleto"
                               class="form-control" />

                        <span asp-validation-for="NombreCompleto"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Usuario"
                               class="form-label">
                        </label>

                        <input asp-for="Usuario"
                               class="form-control" />

                        <span asp-validation-for="Usuario"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Password"
                               class="form-label">
                        </label>

                        <input asp-for="Password"
                               class="form-control" />

                        <span asp-validation-for="Password"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="ConfirmarPassword"
                               class="form-label">
                        </label>

                        <input asp-for="ConfirmarPassword"
                               class="form-control" />

                        <span asp-validation-for="ConfirmarPassword"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Roles
                        </label>

                        <select asp-for="Roles"
                                class="form-select"
                                multiple
                                size="5">

                            @foreach (var rol in roles)
                            {
                                <option value="@rol">
                                    @rol
                                </option>
                            }

                        </select>

                        <small class="text-muted">
                            Mantenga Ctrl presionado para seleccionar
                            varios roles.
                        </small>

                    </div>

                    <div class="col-12">

                        <div class="form-check">

                            <input asp-for="Activo"
                                   class="form-check-input" />

                            <label asp-for="Activo"
                                   class="form-check-label">
                            </label>

                        </div>

                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Crear usuario
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}