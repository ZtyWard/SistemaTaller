@model IEnumerable<Negocios.DTOs.UsuarioAdministracionDto>

@{
    ViewData["Title"] = "Administración de usuarios";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Administración de usuarios</h1>
            <p class="text-muted mb-0">
                Gestiona los usuarios y accesos del sistema AXIS.
            </p>
        </div>

        @if (User.HasClaim("Permiso", Negocios.Seguridad.Permisos.UsuariosCrear))
        {
            <a asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-person-plus me-1"></i>
                Nuevo usuario
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Nombre completo</th>
                            <th>Correo</th>
                            <th>Roles</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var usuario in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @usuario.Usuario
                                    </strong>
                                </td>

                                <td>
                                    @usuario.NombreCompleto
                                </td>

                                <td>
                                    @usuario.Email
                                </td>

                                <td>
                                    @if (usuario.Roles.Any())
                                    {
                                        foreach (var rol in usuario.Roles)
                                        {
                                            <span class="badge bg-secondary me-1">
                                                @rol
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Sin rol
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (usuario.Activo)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    <div class="btn-group">

                                        <a asp-action="Details"
                                           asp-route-id="@usuario.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Ver
                                        </a>

                                        @if (User.HasClaim(
                                                                            "Permiso",
                                                                            Negocios.Seguridad.Permisos.UsuariosEditar))
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@usuario.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Editar
                                            </a>
                                        }

                                        @if (User.HasClaim(
                                                                            "Permiso",
                                                                            Negocios.Seguridad.Permisos.UsuariosDesactivar))
                                        {
                                            <form asp-action="CambiarEstado"
                                                  asp-route-id="@usuario.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                @if (usuario.Activo)
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('¿Desea desactivar este usuario?');">
                                                        Desactivar
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success">
                                                        Activar
                                                    </button>
                                                }

                                            </form>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <h5>No hay usuarios registrados.</h5>

                    <p class="text-muted">
                        Cree el primer usuario desde el botón
                        "Nuevo usuario".
                    </p>

                </div>
            }

        </div>
    </div>

</div>