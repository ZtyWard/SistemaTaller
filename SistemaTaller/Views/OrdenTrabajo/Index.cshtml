@model IEnumerable<Negocios.DTOs.OrdenTrabajoDto>

@{
    ViewData["Title"] = "Órdenes de trabajo";

    var estadosOrden = new[]
    {
        "Registrada",
        "Pendiente de aprobación",
        "Aprobada",
        "En proceso",
        "En espera de repuestos",
        "Suspendida",
        "Finalizada",
        "Facturada",
        "Entregada",
        "Cancelada"
    };
}

<section class="axis-page">

    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <div class="axis-page-header">

        <div>

            <span class="axis-page-kicker">
                OPERACIONES · ÓRDENES DE TRABAJO
            </span>

            <h1>
                Órdenes de trabajo
            </h1>

            <p>
                Controla los trabajos activos y el estado de servicio
                de cada vehículo.
            </p>

        </div>

        <div class="axis-page-actions">

            <a asp-action="Abiertas"
               class="axis-button axis-button-secondary">
                Abiertas
            </a>

            <a asp-action="Create"
               class="axis-button axis-button-primary">
                + Nueva orden
            </a>

        </div>

    </div>


    <!-- =====================================================
         MENSAJES
         ===================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="axis-alert axis-alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="axis-alert axis-alert-error">
            @TempData["Error"]
        </div>
    }


    <!-- =====================================================
         CONTADOR
         ===================================================== -->

    <div class="axis-toolbar">

        <span class="axis-record-count">
            @Model.Count() órdenes registradas
        </span>

    </div>


    <!-- =====================================================
         TABLA
         ===================================================== -->

    <div class="axis-table-card">

        <div class="axis-table-wrapper">

            <table class="axis-table">

                <thead>

                    <tr>

                        <th>
                            Orden
                        </th>

                        <th>
                            Cliente
                        </th>

                        <th>
                            Vehículo
                        </th>

                        <th>
                            Inicio
                        </th>

                        <th>
                            Finalización
                        </th>

                        <th>
                            Estado
                        </th>

                        <th>
                            Total
                        </th>

                        <th class="axis-table-actions-column">
                            Acciones
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="8"
                                class="axis-empty">

                                No hay órdenes de trabajo registradas.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var orden in Model)
                        {
                            <tr>

                                <!-- =================================================
                                     ORDEN
                                     ================================================= -->

                                <td>

                                    <div class="axis-client-cell">

                                        <div class="axis-client-avatar">
                                            OT
                                        </div>

                                        <div>

                                            <strong>
                                                #@orden.IdOrdenTrabajo
                                            </strong>

                                            <small class="axis-table-secondary-text">
                                                Cotización #@orden.IdCotizacion
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- =================================================
                                     CLIENTE
                                     ================================================= -->

                                <td>

                                    <strong>
                                        @orden.ClienteNombre
                                    </strong>

                                </td>


                                <!-- =================================================
                                     VEHÍCULO
                                     ================================================= -->

                                <td>

                                    <strong>
                                        @orden.Placa
                                    </strong>

                                </td>


                                <!-- =================================================
                                     FECHA INICIO
                                     ================================================= -->

                                <td>

                                    @orden.FechaInicio.ToString("dd/MM/yyyy")

                                </td>


                                <!-- =================================================
                                     FECHA FINALIZACIÓN
                                     ================================================= -->

                                <td>

                                    @if (orden.FechaFin.HasValue)
                                    {
                                        @orden.FechaFin.Value.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span class="axis-table-secondary-text">
                                            En proceso
                                        </span>
                                    }

                                </td>


                                <!-- =================================================
                                     ESTADO
                                     ================================================= -->

                                <td>

                                    @{
                                        var estadoActivo =
                                        orden.Estado.Equals(
                                        "Finalizada",
                                        StringComparison.OrdinalIgnoreCase);

                                        var estadoCancelado =
                                        orden.Estado.Equals(
                                        "Cancelada",
                                        StringComparison.OrdinalIgnoreCase);
                                    }

                            <span class="axis-status
                                        @(estadoActivo
                                                                              ? "axis-status-active"
                                                                              : estadoCancelado
                                                                                  ? "axis-status-error"
                                                                                  : "axis-status-warning")">

                                @orden.Estado

                                    </span>

                                </td>


                                <!-- =================================================
                                     TOTAL
                                     ================================================= -->

                                <td>

                                    <strong>
                                        ₡@orden.TotalCotizacion.ToString("N2")
                                    </strong>

                                </td>


                                <!-- =================================================
                                     ACCIONES
                                     ================================================= -->

                                <td>

                                    <div class="axis-row-actions">

                                        <!-- Ver -->

                                        <a asp-action="Details"
                                           asp-route-id="@orden.IdOrdenTrabajo"
                                           class="axis-row-action">

                                            Ver

                                        </a>


                                        <!-- Editar -->

                                        <a asp-action="Edit"
                                           asp-route-id="@orden.IdOrdenTrabajo"
                                           class="axis-row-action">

                                            Editar

                                        </a>


                                        <!-- =================================================
                                             CAMBIAR ESTADO
                                             ================================================= -->
                                @if (!orden.Estado.Equals(
                                                                "Entregada",
                                                                StringComparison.OrdinalIgnoreCase))
                                        {
                                            <form asp-action="CambiarEstado"
                                                  asp-route-id="@orden.IdOrdenTrabajo"
                                                  method="post"
                                                  style="display:inline-flex; align-items:center; gap:6px;">

                                                @Html.AntiForgeryToken()

                                                <select name="estado"
                                                        class="axis-form-control"
                                                        style="min-width:190px;">

                                                    @foreach (var estado in estadosOrden)
                                                    {
                                                        if (orden.Estado.Equals(
                                                        estado,
                                                        StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <option value="@estado"
                                                                    selected>

                                                                @estado

                                                            </option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@estado">

                                                                @estado

                                                            </option>
                                                        }
                                                    }

                                                </select>

                                                <button type="submit"
                                                        class="axis-row-action">

                                                    Guardar

                                                </button>

                                            </form>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</section>