@{
    ViewData["Title"] = "Inicio";
}

<section class="axis-home">

    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <div class="axis-intro">

        <div>

            <span class="axis-kicker">
                SISTEMA DE GESTIÓN · TALLER
            </span>

            <h1>
                AXIS
            </h1>

            <p>
                Operaciones, vehículos y servicio en un solo lugar.
            </p>

        </div>

        <div class="axis-date">

            <span>
                OPERACIONES
            </span>

            <strong>
                HOY
            </strong>

        </div>

    </div>


    <!-- =====================================================
         GALERÍA PRINCIPAL
         ===================================================== -->

    <div class="axis-module-gallery">

        <!-- ASPHALT -->

        <a class="axis-module"
           asp-controller="Account"
           asp-action="Login">

            <div class="axis-module-image axis-image-asphalt"></div>

            <div class="axis-module-overlay"></div>

            <span class="axis-module-title">
                ASPHALT
            </span>

            <div class="axis-module-info">

                <span>
                    01
                </span>

                <strong>
                    AXIS Asphalt
                </strong>

                <small>
                    Acceder al sistema
                </small>

            </div>

        </a>


        <!-- ACERCA DE -->

        <a class="axis-module"
           asp-controller="Home"
           asp-action="About">

            <div class="axis-module-image axis-image-about"></div>

            <div class="axis-module-overlay"></div>

            <span class="axis-module-title">
                ACERCA DE
            </span>

            <div class="axis-module-info">

                <span>
                    02
                </span>

                <strong>
                    Nuestro proyecto
                </strong>

                <small>
                    Conoce al equipo
                </small>

            </div>

        </a>

    </div>

</section>