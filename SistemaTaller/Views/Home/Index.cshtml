@{
    ViewData["Title"] = "Inicio";
}

<section class="axis-home">

    <div class="axis-intro">

        <div>
            <span class="axis-kicker">
                SISTEMA DE GESTIÓN · TALLER
            </span>

            <h1>AXIS</h1>

            <p>
                Operaciones, vehículos y servicio
                en un solo lugar.
            </p>
        </div>

        <div class="axis-date">
            <span>OPERACIONES</span>
            <strong>HOY</strong>
        </div>

    </div>

    <div class="axis-module-gallery">

        <a class="axis-module"
           asp-controller="Clientes"
           asp-action="Index">

            <div class="axis-module-image axis-image-clientes"></div>

            <div class="axis-module-overlay"></div>

            <span class="axis-module-title">
                CLIENTES
            </span>

            <div class="axis-module-info">
                <span>01</span>
                <strong>Clientes</strong>
                <small>Gestionar clientes</small>
            </div>

        </a>

        <a class="axis-module"
           asp-controller="Vehiculos"
           asp-action="Index">

            <div class="axis-module-image axis-image-vehiculos"></div>

            <div class="axis-module-overlay"></div>

            <span class="axis-module-title">
                VEHÍCULOS
            </span>

            <div class="axis-module-info">
                <span>02</span>
                <strong>Vehículos</strong>
                <small>Registro y control</small>
            </div>

        </a>

        <a class="axis-module"
           asp-controller="Recepcion"
           asp-action="Index">

            <div class="axis-module-image axis-image-recepcion"></div>

            <div class="axis-module-overlay"></div>

            <span class="axis-module-title">
                RECEPCIÓN
            </span>

            <div class="axis-module-info">
                <span>03</span>
                <strong>Recepción</strong>
                <small>Ingreso de vehículos</small>
            </div>

        </a>

        <a class="axis-module"
           asp-controller="Diagnostico"
           asp-action="Index">

            <div class="axis-module-image axis-image-diagnostico"></div>

            <div class="axis-module-overlay"></div>

            <span class="axis-module-title">
                DIAGNÓSTICO
            </span>

            <div class="axis-module-info">
                <span>04</span>
                <strong>Diagnóstico</strong>
                <small>Evaluación técnica</small>
            </div>

        </a>

        <a class="axis-module"
           asp-controller="Cotizacion"
           asp-action="Index">

            <div class="axis-module-image axis-image-cotizacion"></div>

            <div class="axis-module-overlay"></div>

            <span class="axis-module-title">
                COTIZACIÓN
            </span>

            <div class="axis-module-info">
                <span>05</span>
                <strong>Cotizaciones</strong>
                <small>Presupuestos</small>
            </div>

        </a>

        <a class="axis-module"
           asp-controller="OrdenTrabajo"
           asp-action="Index">

            <div class="axis-module-image axis-image-ordenes"></div>

            <div class="axis-module-overlay"></div>

            <span class="axis-module-title">
                ÓRDENES
            </span>

            <div class="axis-module-info">
                <span>06</span>
                <strong>Órdenes de trabajo</strong>
                <small>Control operativo</small>
            </div>

        </a>

    </div>

</section>