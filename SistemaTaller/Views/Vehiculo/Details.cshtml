@model Negocios.DTOs.VehiculoDto

@{
    Layout = "_LayoutInterno";
    ViewData["Title"] = "Detalle del vehículo";
}

<section class="axis-page">

    <div class="axis-page-header">

        <div>

            <span class="axis-page-kicker">
                CLIENTES Y VEHÍCULOS
            </span>

            <h1>
                Vehículo
            </h1>

            <p>
                Información detallada del vehículo seleccionado.
            </p>

        </div>

        <div class="axis-page-actions">

            <a asp-action="Edit"
               asp-route-id="@Model.IdVehiculo"
               class="axis-button axis-button-primary">
                Editar
            </a>

            <a asp-action="Index"
               class="axis-button axis-button-secondary">
                ← Volver
            </a>

        </div>

    </div>


    <div class="axis-detail-grid">

        <!-- ================================================
             RESUMEN
             ================================================ -->

        <div class="axis-detail-card">

            <div class="axis-detail-card-header">

                <div class="axis-detail-avatar">
                    @Model.Placa.Substring(0, 1).ToUpper()
                </div>

                <div>

                    <span class="axis-detail-label">
                        VEHÍCULO
                    </span>

                    <h2>
                        @Model.MarcaNombre
                        @Model.ModeloNombre
                    </h2>

                    <span class="axis-table-secondary-text">
                        @Model.Placa
                    </span>

                </div>

            </div>


            <div class="axis-detail-status">

                @if (Model.Activo)
                {
                    <span class="axis-status axis-status-active">
                        Activo
                    </span>
                }
                else
                {
                    <span class="axis-status axis-status-inactive">
                        Inactivo
                    </span>
                }

            </div>

        </div>


        <!-- ================================================
             PROPIETARIO
             ================================================ -->

        <div class="axis-detail-card">

            <span class="axis-detail-label">
                PROPIETARIO
            </span>

            <div class="axis-detail-list">

                <div class="axis-detail-row">

                    <span>
                        Cliente
                    </span>

                    <strong>
                        @Model.ClienteNombre
                    </strong>

                </div>

                <div class="axis-detail-row">

                    <span>
                        ID cliente
                    </span>

                    <strong>
                        #@Model.IdCliente
                    </strong>

                </div>

            </div>

        </div>


        <!-- ================================================
             INFORMACIÓN DEL VEHÍCULO
             ================================================ -->

        <div class="axis-detail-card">

            <span class="axis-detail-label">
                INFORMACIÓN DEL VEHÍCULO
            </span>

            <div class="axis-detail-list">

                <div class="axis-detail-row">

                    <span>
                        Marca
                    </span>

                    <strong>
                        @Model.MarcaNombre
                    </strong>

                </div>

                <div class="axis-detail-row">

                    <span>
                        Modelo
                    </span>

                    <strong>
                        @Model.ModeloNombre
                    </strong>

                </div>

                <div class="axis-detail-row">

                    <span>
                        Tipo
                    </span>

                    <strong>
                        @Model.TipoVehiculoNombre
                    </strong>

                </div>

                <div class="axis-detail-row">

                    <span>
                        Combustible
                    </span>

                    <strong>
                        @Model.TipoCombustibleNombre
                    </strong>

                </div>

            </div>

        </div>


        <!-- ================================================
             DATOS TÉCNICOS
             ================================================ -->

        <div class="axis-detail-card">

            <span class="axis-detail-label">
                DATOS TÉCNICOS
            </span>

            <div class="axis-detail-list">

                <div class="axis-detail-row">

                    <span>
                        Placa
                    </span>

                    <strong>
                        @Model.Placa
                    </strong>

                </div>

                <div class="axis-detail-row">

                    <span>
                        VIN
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.VIN)
                                                ? "—"
                                                : Model.VIN)
                    </strong>

                </div>

                <div class="axis-detail-row">

                    <span>
                        Año
                    </span>

                    <strong>
                        @(Model.Anio?.ToString() ?? "—")
                    </strong>

                </div>

                <div class="axis-detail-row">

                    <span>
                        Color
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Color)
                                                ? "—"
                                                : Model.Color)
                    </strong>

                </div>

                <div class="axis-detail-row">

                    <span>
                        Kilometraje
                    </span>

                    <strong>
                        @(Model.Kilometraje.HasValue
                                                ? Model.Kilometraje.Value.ToString("N0") + " km"
                                                : "—")
                    </strong>

                </div>

            </div>

        </div>


        <!-- ================================================
             IDENTIFICACIÓN
             ================================================ -->

        <div class="axis-detail-card">

            <span class="axis-detail-label">
                REGISTRO
            </span>

            <div class="axis-detail-list">

                <div class="axis-detail-row">

                    <span>
                        ID vehículo
                    </span>

                    <strong>
                        #@Model.IdVehiculo
                    </strong>

                </div>

                <div class="axis-detail-row">

                    <span>
                        Estado
                    </span>

                    @if (Model.Activo)
                    {
                        <strong class="axis-detail-active-text">
                            Activo
                        </strong>
                    }
                    else
                    {
                        <strong>
                            Inactivo
                        </strong>
                    }

                </div>

            </div>

        </div>

    </div>

</section>