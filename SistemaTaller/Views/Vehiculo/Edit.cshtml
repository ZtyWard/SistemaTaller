@model Negocios.DTOs.VehiculoGuardarDto

@{
    Layout = "_LayoutInterno";
    ViewData["Title"] = "Editar vehículo";

    var obtenerModelosUrl =
        Url.Action(
            "ObtenerModelosPorMarca",
            "Vehiculo");
}

<section class="axis-page">

    <div class="axis-page-header">

        <div>

            <span class="axis-page-kicker">
                CLIENTES Y VEHÍCULOS
            </span>

            <h1>
                Editar vehículo
            </h1>

            <p>
                Actualiza la información del vehículo.
            </p>

        </div>

        <div class="axis-page-actions">

            <a asp-action="Details"
               asp-route-id="@ViewBag.IdVehiculo"
               class="axis-button axis-button-secondary">
                Ver vehículo
            </a>

            <a asp-action="Index"
               class="axis-button axis-button-secondary">
                ← Volver
            </a>

        </div>

    </div>


    <div class="axis-form-card">

        <form asp-action="Edit"
              asp-route-id="@ViewBag.IdVehiculo"
              method="post"
              class="axis-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="axis-form-validation">
            </div>


            <!-- =================================================
                 CLASIFICACIÓN
                 ================================================= -->

            <div class="axis-form-section">

                <div class="axis-form-section-title">
                    Clasificación
                </div>

                <div class="axis-form-grid">


                    <!-- CLIENTE -->

                    <div class="axis-field">

                        <label asp-for="IdCliente">
                            Cliente
                        </label>

                        <select asp-for="IdCliente"
                                asp-items="ViewBag.Clientes">

                            <option value="">
                                Seleccione un cliente
                            </option>

                        </select>

                        <span asp-validation-for="IdCliente"></span>

                    </div>


                    <!-- MARCA -->

                    <div class="axis-field">

                        <label asp-for="IdMarca">
                            Marca
                        </label>

                        <select asp-for="IdMarca"
                                asp-items="ViewBag.Marcas"
                                id="IdMarca">

                            <option value="">
                                Seleccione una marca
                            </option>

                        </select>

                        <span asp-validation-for="IdMarca"></span>

                    </div>


                    <!-- MODELO -->

                    <div class="axis-field">

                        <label asp-for="IdModelo">
                            Modelo
                        </label>

                        <select asp-for="IdModelo"
                                asp-items="ViewBag.Modelos"
                                id="IdModelo">

                            <option value="">
                                Seleccione un modelo
                            </option>

                        </select>

                        <span asp-validation-for="IdModelo"></span>

                        <small id="EstadoModelos">
                            Modelos disponibles para la marca seleccionada.
                        </small>

                    </div>


                    <!-- TIPO VEHÍCULO -->

                    <div class="axis-field">

                        <label asp-for="IdTipoVehiculo">
                            Tipo de vehículo
                        </label>

                        <select asp-for="IdTipoVehiculo"
                                asp-items="ViewBag.TiposVehiculo">

                            <option value="">
                                Seleccione un tipo
                            </option>

                        </select>

                        <span asp-validation-for="IdTipoVehiculo"></span>

                    </div>


                    <!-- COMBUSTIBLE -->

                    <div class="axis-field">

                        <label asp-for="IdTipoCombustible">
                            Combustible
                        </label>

                        <select asp-for="IdTipoCombustible"
                                asp-items="ViewBag.TiposCombustible">

                            <option value="">
                                Seleccione un combustible
                            </option>

                        </select>

                        <span asp-validation-for="IdTipoCombustible"></span>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 INFORMACIÓN DEL VEHÍCULO
                 ================================================= -->

            <div class="axis-form-section">

                <div class="axis-form-section-title">
                    Información del vehículo
                </div>

                <div class="axis-form-grid">


                    <!-- PLACA -->

                    <div class="axis-field">

                        <label asp-for="Placa">
                            Placa
                        </label>

                        <input asp-for="Placa"
                               placeholder="Ej. ABC123" />

                        <span asp-validation-for="Placa"></span>

                    </div>


                    <!-- AÑO -->

                    <div class="axis-field">

                        <label asp-for="Anio">
                            Año
                        </label>

                        <input asp-for="Anio"
                               type="number"
                               placeholder="Ej. 2022" />

                        <span asp-validation-for="Anio"></span>

                    </div>


                    <!-- COLOR -->

                    <div class="axis-field">

                        <label asp-for="Color">
                            Color
                        </label>

                        <input asp-for="Color"
                               placeholder="Color del vehículo" />

                        <span asp-validation-for="Color"></span>

                    </div>


                    <!-- KILOMETRAJE -->

                    <div class="axis-field">

                        <label asp-for="Kilometraje">
                            Kilometraje
                        </label>

                        <input asp-for="Kilometraje"
                               type="number"
                               placeholder="Ej. 85000" />

                        <span asp-validation-for="Kilometraje"></span>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 ACCIONES
                 ================================================= -->

            <div class="axis-form-actions">

                <a asp-action="Index"
                   class="axis-button axis-button-secondary">
                    Cancelar
                </a>

                <button type="submit"
                        class="axis-button axis-button-primary">
                    Guardar cambios
                </button>

            </div>

        </form>

    </div>

</section>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        // =====================================================
        // URL
        // =====================================================

        const obtenerModelosUrl =
            '@obtenerModelosUrl';


        // =====================================================
        // ELEMENTOS
        // =====================================================

        const marcaSelect =
            document.getElementById('IdMarca');

        const modeloSelect =
            document.getElementById('IdModelo');

        const estadoModelos =
            document.getElementById('EstadoModelos');


        // =====================================================
        // CARGAR MODELOS
        // =====================================================

        async function cargarModelosPorMarca(
            idMarca,
            modeloSeleccionado = ''
        ) {

            modeloSelect.innerHTML = `
                <option value="">
                    Cargando modelos...
                </option>
            `;

            modeloSelect.disabled = true;

            estadoModelos.textContent =
                'Cargando modelos...';


            if (!idMarca) {

                modeloSelect.innerHTML = `
                    <option value="">
                        Seleccione una marca primero
                    </option>
                `;

                estadoModelos.textContent =
                    'Seleccione una marca para cargar sus modelos.';

                return;
            }


            try {

                const url =
                    `${obtenerModelosUrl}?idMarca=${encodeURIComponent(idMarca)}`;


                const response =
                    await fetch(url, {
                        method: 'GET',
                        headers: {
                            'Accept': 'application/json'
                        }
                    });


                if (!response.ok) {

                    throw new Error(
                        `HTTP ${response.status}`
                    );

                }


                const modelos =
                    await response.json();


                modeloSelect.innerHTML = `
                    <option value="">
                        Seleccione un modelo
                    </option>
                `;


                if (
                    !modelos ||
                    modelos.length === 0
                ) {

                    modeloSelect.innerHTML = `
                        <option value="">
                            No hay modelos para esta marca
                        </option>
                    `;

                    estadoModelos.textContent =
                        'No existen modelos activos para esta marca.';

                    return;
                }


                modelos.forEach(modelo => {

                    const option =
                        document.createElement('option');

                    option.value =
                        modelo.id;

                    option.textContent =
                        modelo.nombre;


                    if (
                        modeloSeleccionado &&
                        String(modelo.id) ===
                        String(modeloSeleccionado)
                    ) {

                        option.selected = true;

                    }


                    modeloSelect.appendChild(
                        option
                    );

                });


                modeloSelect.disabled = false;

                estadoModelos.textContent =
                    `${modelos.length} modelo(s) disponible(s).`;

            }
            catch (error) {

                console.error(
                    'Error cargando modelos:',
                    error
                );

                modeloSelect.innerHTML = `
                    <option value="">
                        Error al cargar modelos
                    </option>
                `;

                estadoModelos.textContent =
                    'No se pudieron cargar los modelos.';

            }

        }


        // =====================================================
        // CAMBIO DE MARCA
        // =====================================================

        marcaSelect.addEventListener(
            'change',
            function () {

                cargarModelosPorMarca(
                    this.value
                );

            }
        );


        // =====================================================
        // INICIALIZACIÓN
        // =====================================================

        document.addEventListener(
            'DOMContentLoaded',
            function () {

                const marcaInicial =
                    marcaSelect.value;

                const modeloInicial =
                    modeloSelect.value;


                if (marcaInicial) {

                    cargarModelosPorMarca(
                        marcaInicial,
                        modeloInicial
                    );

                }
                else {

                    modeloSelect.disabled =
                        true;

                }

            }
        );

    </script>

}