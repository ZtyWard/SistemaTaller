@model IEnumerable<Negocios.DTOs.CotizacionDto>

@{
    ViewData["Title"] = "Cotizaciones";
}

<section class="axis-page">

    <div class="axis-page-header">

        <div>
            <span class="axis-page-kicker">
                SERVICIO · COTIZACIONES
            </span>

            <h1>
                Cotizaciones
            </h1>

            <p>
                Gestiona los presupuestos generados a partir de los diagnósticos.
            </p>
        </div>

        <div class="axis-page-actions">

            <a asp-action="Pendientes"
               class="axis-button axis-button-secondary">
                Pendientes
            </a>

            <a asp-action="Create"
               class="axis-button axis-button-primary">
                + Nueva cotización
            </a>

        </div>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="axis-alert axis-alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="axis-alert axis-alert-error">
            @TempData["Error"]
        </div>
    }


    <div class="axis-toolbar">

        <span class="axis-record-count">
            @Model.Count() cotizaciones registradas
        </span>

    </div>


    <div class="axis-table-card">

        <div class="axis-table-wrapper">

            <table class="axis-table">

                <thead>
                    <tr>

                        <th>
                            Cotización
                        </th>

                        <th>
                            Vehículo
                        </th>

                        <th>
                            Diagnóstico
                        </th>

                        <th>
                            Fecha
                        </th>

                        <th>
                            Total
                        </th>

                        <th>
                            Estado
                        </th>

                        <th>
                            Orden de trabajo
                        </th>

                        <th class="axis-table-actions-column">
                            Acciones
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8"
                                class="axis-empty">

                                No hay cotizaciones registradas.

                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var cotizacion in Model)
                        {
                            <tr>

                                <td>

                                    <div class="axis-client-cell">

                                        <div class="axis-client-avatar">
                                            C
                                        </div>

                                        <div>

                                            <strong>
                                                #@cotizacion.IdCotizacion
                                            </strong>

                                            <small class="axis-table-secondary-text">
                                                Cotización
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <td>

                                    <strong>
                                        @cotizacion.Placa
                                    </strong>

                                </td>


                                <td>

                                    <span>
                                        #@cotizacion.IdDiagnostico
                                    </span>

                                </td>


                                <td>
                                    @cotizacion.Fecha.ToString("dd/MM/yyyy")
                                </td>


                                <td>

                                    <strong>
                                        ₡@cotizacion.Total.ToString("N2")
                                    </strong>

                                </td>


                                <td>

                                    @if (cotizacion.Estado.Equals(
                                                                "Pendiente",
                                                                StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="axis-status axis-status-inactive">
                                            @cotizacion.Estado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="axis-status axis-status-active">
                                            @cotizacion.Estado
                                        </span>
                                    }

                                </td>


                                <td>

                                    @if (cotizacion.TieneOrdenTrabajo)
                                    {
                                        <span class="axis-status axis-status-active">
                                            GENERADA
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="axis-status axis-status-inactive">
                                            PENDIENTE
                                        </span>
                                    }

                                </td>


                                <td>

                                    <div class="axis-row-actions">

                                        <a asp-action="Details"
                                           asp-route-id="@cotizacion.IdCotizacion"
                                           class="axis-row-action">
                                            Ver
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@cotizacion.IdCotizacion"
                                           class="axis-row-action">
                                            Editar
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</section>