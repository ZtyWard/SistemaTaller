@model Negocios.DTOs.CotizacionGuardarDto

@{
    ViewData["Title"] = "Editar cotización";
}

<section class="axis-page">

    <div class="axis-page-header">

        <div>

            <span class="axis-page-kicker">
                SERVICIO · COTIZACIONES
            </span>

            <h1>
                Editar cotización
            </h1>

            <p>
                Actualiza la información del presupuesto seleccionado.
            </p>

        </div>

        <div class="axis-page-actions">

            <a asp-action="Details"
               asp-route-id="@ViewBag.IdCotizacion"
               class="axis-button axis-button-secondary">
                Ver cotización
            </a>

            <a asp-action="Index"
               class="axis-button axis-button-secondary">
                ← Volver
            </a>

        </div>

    </div>


    <div class="axis-form-card">

        <form asp-action="Edit"
              asp-route-id="@ViewBag.IdCotizacion"
              method="post"
              class="axis-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="axis-form-validation">
            </div>


            <div class="axis-form-section">

                <div class="axis-form-section-title">
                    Información de la cotización
                </div>

                <div class="axis-form-grid">


                    <div class="axis-field">

                        <label asp-for="IdDiagnostico">
                            Diagnóstico
                        </label>

                        <input asp-for="IdDiagnostico"
                               type="number"
                               min="1" />

                        <span asp-validation-for="IdDiagnostico"></span>

                    </div>


                    <div class="axis-field">

                        <label asp-for="Total">
                            Total
                        </label>

                        <input asp-for="Total"
                               type="number"
                               step="0.01"
                               min="0" />

                        <span asp-validation-for="Total"></span>

                    </div>


                    <div class="axis-field">

                        <label asp-for="Estado">
                            Estado
                        </label>

                        <select asp-for="Estado">

                            <option value="Pendiente">
                                Pendiente
                            </option>

                            <option value="Aprobada">
                                Aprobada
                            </option>

                            <option value="Rechazada">
                                Rechazada
                            </option>

                        </select>

                        <span asp-validation-for="Estado"></span>

                    </div>

                </div>

            </div>


            <div class="axis-form-actions">

                <a asp-action="Index"
                   class="axis-button axis-button-secondary">
                    Cancelar
                </a>

                <button type="submit"
                        class="axis-button axis-button-primary">
                    Guardar cambios
                </button>

            </div>

        </form>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}