@model Negocios.DTOs.VentaGuardarDto

@{
    ViewData["Title"] = "Editar venta";
    var idVenta = ViewBag.IdVenta;
}

<section class="axis-page">

    <div class="axis-page-header">
        <div>
            <span class="axis-page-kicker">
                VENTAS · REGISTRO
            </span>

            <h1>Editar venta</h1>

            <p>
                Actualiza la información de la venta seleccionada.
            </p>
        </div>

        <a asp-action="Index"
           class="axis-button axis-button-secondary">
            ← Volver
        </a>
    </div>

    <div class="axis-form-card">

        <form asp-action="Edit"
              asp-route-id="@idVenta"
              method="post"
              class="axis-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="axis-form-validation">
            </div>

            <!-- =====================================================
                 INFORMACIÓN DE LA VENTA
                 ===================================================== -->

            <div class="axis-form-section">

                <div class="axis-form-section-title">
                    Información de la venta
                </div>

                <div class="axis-form-grid">

                    <div class="axis-field">
                        <label asp-for="NumeroVenta">
                            Número de venta
                        </label>

                        <input asp-for="NumeroVenta"
                               placeholder="Número de venta" />
                    </div>

                    <div class="axis-field">
                        <label asp-for="IdCliente">
                            Cliente
                        </label>

                        <input asp-for="IdCliente"
                               type="number"
                               min="1"
                               placeholder="Opcional" />
                    </div>

                    <div class="axis-field">
                        <label asp-for="IdVendedor">
                            Vendedor
                        </label>

                        <input asp-for="IdVendedor"
                               type="number"
                               min="1" />
                    </div>

                    <div class="axis-field">
                        <label asp-for="IdCajero">
                            Cajero
                        </label>

                        <input asp-for="IdCajero"
                               type="number"
                               min="1"
                               placeholder="Opcional" />
                    </div>

                    <div class="axis-field">
                        <label asp-for="FechaVenta">
                            Fecha de venta
                        </label>

                        <input asp-for="FechaVenta"
                               type="datetime-local" />
                    </div>

                    <div class="axis-field">
                        <label asp-for="FormaPago">
                            Forma de pago
                        </label>

                        <input asp-for="FormaPago"
                               placeholder="Efectivo" />
                    </div>

                    <div class="axis-field">
                        <label asp-for="Estado">
                            Estado
                        </label>

                        <select asp-for="Estado">
                            <option value="Pendiente">
                                Pendiente
                            </option>

                            <option value="Completada">
                                Completada
                            </option>

                            <option value="Cancelada">
                                Cancelada
                            </option>
                        </select>
                    </div>

                    <div class="axis-field">
                        <label asp-for="Total">
                            Total
                        </label>

                        <input asp-for="Total"
                               type="number"
                               step="0.01"
                               min="0" />
                    </div>

                </div>

            </div>

            <!-- =====================================================
                 DETALLES DE LA VENTA
                 ===================================================== -->

            <div class="axis-form-section">

                <div class="axis-form-section-title">
                    Detalle de la venta
                </div>

                @if (Model.Detalles != null && Model.Detalles.Count > 0)
                {
                    @for (int i = 0; i < Model.Detalles.Count; i++)
                    {
                        <div class="axis-form-grid"
                             style="margin-bottom: 24px;">

                            <div class="axis-field">

                                <label asp-for="Detalles[i].IdProducto">
                                    Producto
                                </label>

                                <input asp-for="Detalles[i].IdProducto"
                                       type="number"
                                       min="1" />

                            </div>

                            <div class="axis-field">

                                <label asp-for="Detalles[i].Cantidad">
                                    Cantidad
                                </label>

                                <input asp-for="Detalles[i].Cantidad"
                                       type="number"
                                       min="1" />

                            </div>

                            <div class="axis-field">

                                <label asp-for="Detalles[i].PrecioUnitario">
                                    Precio unitario
                                </label>

                                <input asp-for="Detalles[i].PrecioUnitario"
                                       type="number"
                                       step="0.01"
                                       min="0" />

                            </div>

                            <div class="axis-field">

                                <label asp-for="Detalles[i].Impuesto">
                                    Impuesto
                                </label>

                                <input asp-for="Detalles[i].Impuesto"
                                       type="number"
                                       step="0.01"
                                       min="0" />

                            </div>

                            <div class="axis-field">

                                <label asp-for="Detalles[i].Descuento">
                                    Descuento
                                </label>

                                <input asp-for="Detalles[i].Descuento"
                                       type="number"
                                       step="0.01"
                                       min="0" />

                            </div>

                        </div>

                        @if (i < Model.Detalles.Count - 1)
                        {
                            <hr style="margin: 20px 0;" />
                        }
                    }
                }
                else
                {
                    <div class="axis-empty-state">
                        <p>
                            Esta venta no tiene detalles registrados.
                        </p>
                    </div>
                }

            </div>

            <!-- =====================================================
                 ACCIONES
                 ===================================================== -->

            <div class="axis-form-actions">

                <a asp-action="Index"
                   class="axis-button axis-button-secondary">
                    Cancelar
                </a>

                <button type="submit"
                        class="axis-button axis-button-primary">
                    Guardar cambios
                </button>

            </div>

        </form>

    </div>

</section>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}