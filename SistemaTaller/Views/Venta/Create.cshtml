@model Negocios.DTOs.VentaGuardarDto

@{
    ViewData["Title"] = "Nueva venta";
}

<section class="axis-page">

    <div class="axis-page-header">
        <div>
            <span class="axis-page-kicker">
                VENTAS · PRUEBA DE INTEGRACIÓN
            </span>

            <h1>Nueva venta</h1>

            <p>
                Registra una venta para probar la integración con inventario.
            </p>
        </div>

        <a asp-action="Index"
           class="axis-button axis-button-secondary">
            ← Volver
        </a>
    </div>

    <div class="axis-form-card">
        <form asp-action="Create"
              method="post"
              class="axis-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="axis-form-validation">
            </div>

            <div class="axis-form-section">

                <div class="axis-form-section-title">
                    Información de la venta
                </div>

                <div class="axis-form-grid">

                    <div class="axis-field">
                        <label asp-for="NumeroVenta">
                            Número de venta
                        </label>

                        <input asp-for="NumeroVenta"
                               placeholder="Se genera automáticamente si se deja vacío" />
                    </div>

                    <div class="axis-field">
                        <label asp-for="IdCliente">
                            Cliente
                        </label>

                        <input asp-for="IdCliente"
                               type="number"
                               min="1"
                               placeholder="2" />
                    </div>

                    <div class="axis-field">
                        <label asp-for="IdVendedor">
                            Vendedor
                        </label>

                        <input asp-for="IdVendedor"
                               type="number"
                               min="1"
                               placeholder="1" />
                    </div>

                    <div class="axis-field">
                        <label asp-for="IdCajero">
                            Cajero
                        </label>

                        <input asp-for="IdCajero"
                               type="number"
                               min="1"
                               placeholder="Opcional" />
                    </div>

                    <div class="axis-field">
                        <label asp-for="FechaVenta">
                            Fecha de venta
                        </label>

                        <input asp-for="FechaVenta"
                               type="datetime-local" />
                    </div>

                    <div class="axis-field">
                        <label asp-for="FormaPago">
                            Forma de pago
                        </label>

                        <input asp-for="FormaPago"
                               placeholder="Efectivo" />
                    </div>

                    <div class="axis-field">
                        <label asp-for="Estado">
                            Estado
                        </label>

                        <select asp-for="Estado">
                            <option value="Pendiente">Pendiente</option>
                            <option value="Completada">Completada</option>
                            <option value="Cancelada">Cancelada</option>
                        </select>
                    </div>

                </div>
            </div>

            <div class="axis-form-section">

                <div class="axis-form-section-title">
                    Producto de prueba
                </div>

                <div class="axis-form-grid">

                    <div class="axis-field">
                        <label asp-for="Detalles[0].IdProducto">
                            Producto
                        </label>

                        <input asp-for="Detalles[0].IdProducto"
                               type="number"
                               min="1"
                               value="3"
                               placeholder="3" />
                    </div>

                    <div class="axis-field">
                        <label asp-for="Detalles[0].Cantidad">
                            Cantidad
                        </label>

                        <input asp-for="Detalles[0].Cantidad"
                               type="number"
                               min="1"
                               value="2"
                               placeholder="2" />
                    </div>

                    <div class="axis-field">
                        <label asp-for="Detalles[0].PrecioUnitario">
                            Precio unitario
                        </label>

                        <input asp-for="Detalles[0].PrecioUnitario"
                               type="number"
                               step="0.01"
                               min="0"
                               value="1500" />
                    </div>

                    <div class="axis-field">
                        <label asp-for="Detalles[0].Impuesto">
                            Impuesto
                        </label>

                        <input asp-for="Detalles[0].Impuesto"
                               type="number"
                               step="0.01"
                               min="0"
                               value="0" />
                    </div>

                    <div class="axis-field">
                        <label asp-for="Detalles[0].Descuento">
                            Descuento
                        </label>

                        <input asp-for="Detalles[0].Descuento"
                               type="number"
                               step="0.01"
                               min="0"
                               value="0" />
                    </div>

                </div>
            </div>

            <div class="axis-form-actions">

                <a asp-action="Index"
                   class="axis-button axis-button-secondary">
                    Cancelar
                </a>

                <button type="submit"
                        class="axis-button axis-button-primary">
                    Registrar venta
                </button>

            </div>

        </form>
    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}