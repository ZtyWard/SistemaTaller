@model IEnumerable<Negocios.DTOs.VentaDto>

@{
    ViewData["Title"] = "Ventas";
}

<section class="axis-sales-page">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="axis-sales-header">

        <div>

            <span class="axis-sales-kicker">
                VENTAS · REGISTRO
            </span>

            <h1>
                Ventas
            </h1>

            <p>
                Gestiona las ventas realizadas en el taller.
            </p>

        </div>


        <div class="axis-sales-actions">

            <a asp-controller="Venta"
               asp-action="PorEstado"
               asp-route-estado="Pendiente"
               class="axis-sales-button axis-sales-button-secondary">

                Pendientes

            </a>


            <a asp-controller="Venta"
               asp-action="Recientes"
               class="axis-sales-button axis-sales-button-secondary">

                Recientes

            </a>


            <a asp-controller="Venta"
               asp-action="Create"
               class="axis-sales-button axis-sales-button-primary">

                <span>+</span>

                Nueva venta

            </a>

        </div>

    </div>


    <!-- =====================================================
         MENSAJES
         ===================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="axis-sales-alert axis-sales-alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="axis-sales-alert axis-sales-alert-error">
            @TempData["Error"]
        </div>
    }


    <!-- =====================================================
         CONTENEDOR
         ===================================================== -->

    <div class="axis-sales-card">


        <!-- CARD HEADER -->

        <div class="axis-sales-card-header">

            <div>

                <span class="axis-sales-card-kicker">
                    REGISTRO
                </span>

                <h2>
                    Ventas registradas
                </h2>

                <p>
                    @Model.Count() ventas encontradas.
                </p>

            </div>


            <div class="axis-sales-count">
                @Model.Count()
            </div>

        </div>


        <!-- =================================================
             SIN REGISTROS
             ================================================= -->
        @if (!Model.Any())
        {
            <div class="axis-sales-empty">

                <div class="axis-sales-empty-icon">
                    $
                </div>

                <h3>
                    No hay ventas registradas
                </h3>

                <p>
                    Registra la primera venta para comenzar.
                </p>

                <a asp-controller="Venta"
                   asp-action="Create"
                   class="axis-sales-button axis-sales-button-primary">

                    + Registrar venta

                </a>

            </div>
        }
        else
        {

            <!-- =================================================
                 TABLA
                 ================================================= -->

            <div class="axis-sales-table-wrapper">

                <table class="axis-sales-table">

                    <thead>

                        <tr>

                            <th>
                                VENTA
                            </th>

                            <th>
                                CLIENTE
                            </th>

                            <th>
                                FECHA
                            </th>

                            <th>
                                TOTAL
                            </th>

                            <th>
                                FORMA DE PAGO
                            </th>

                            <th>
                                ESTADO
                            </th>

                            <th class="axis-sales-actions-column">
                                ACCIONES
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var venta in Model)
                        {
                            <tr>

                                <!-- VENTA -->

                                <td>

                                    <div class="axis-sales-record">

                                        <strong>
                                            @venta.NumeroVenta
                                        </strong>

                                        <span>
                                            Venta #@venta.IdVenta
                                        </span>

                                    </div>

                                </td>


                                <!-- CLIENTE -->

                                <td>

                                    <div class="axis-sales-client">

                                        <div class="axis-sales-client-avatar">

                                            @(
                                                                                string.IsNullOrWhiteSpace(venta.Cliente)
                                                                                ? "?"
                                                                                : venta.Cliente.Substring(0, 1).ToUpper()
                                                                                )

                                        </div>

                                        <div>

                                            <strong>
                                                @(string.IsNullOrWhiteSpace(venta.Cliente)
                                                                                        ? "Cliente no disponible"
                                                                                        : venta.Cliente)
                                                                                                    </strong>

                                            <span>
                                                Cliente AXIS
                                            </span>

                                        </div>

                                    </div>

                                </td>


                                <!-- FECHA -->

                                <td>

                                    <div class="axis-sales-date">

                                        <strong>
                                            @venta.FechaVenta.ToString("dd/MM/yyyy")
                                        </strong>

                                        <span>
                                            @venta.FechaVenta.ToString("HH:mm")
                                        </span>

                                    </div>

                                </td>


                                <!-- TOTAL -->

                                <td>

                                    <strong class="axis-sales-total">

                                        @venta.Total.ToString("C2")

                                    </strong>

                                </td>


                                <!-- FORMA DE PAGO -->

                                <td>

                                    <span class="axis-sales-payment">

                                        @(string.IsNullOrWhiteSpace(venta.FormaPago)
                                                                        ? "No especificada"
                                                                        : venta.FormaPago)

                            </span>

                                </td>


                                <!-- ESTADO -->

                                <td>

                            @{
                                        var estadoClass =
                                        venta.Estado switch
                                        {
                                            "Completada" =>
                                                            "axis-sales-status-completed",

                                            "Cancelada" =>
                                                            "axis-sales-status-cancelled",

                                            _ =>
                                                            "axis-sales-status-pending"
                                        };
                                    }

                                    <span class="axis-sales-status @estadoClass">

                                        <span class="axis-sales-status-dot"></span>

                                        @venta.Estado

                                    </span>

                                </td>


                                <!-- ACCIONES -->

                                <td>

                                    <div class="axis-sales-row-actions">

                                        <a asp-controller="Venta"
                                           asp-action="Details"
                                           asp-route-id="@venta.IdVenta"
                                           class="axis-sales-row-button">

                                            Ver

                                        </a>


                                        @if (venta.Estado != "Completada" &&
                                                                        venta.Estado != "Cancelada")
                                        {

                                            <a asp-controller="Venta"
                                               asp-action="Edit"
                                               asp-route-id="@venta.IdVenta"
                                               class="axis-sales-row-button">

                                                Editar

                                            </a>


                                            <form asp-controller="Venta"
                                                  asp-action="CambiarEstado"
                                                  asp-route-id="@venta.IdVenta"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="estado"
                                                       value="Completada" />

                                                <button type="submit"
                                                        class="axis-sales-row-button axis-sales-complete">

                                                    Completar

                                                </button>

                                            </form>


                                            <form asp-controller="Venta"
                                                  asp-action="CambiarEstado"
                                                  asp-route-id="@venta.IdVenta"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="estado"
                                                       value="Cancelada" />

                                                <button type="submit"
                                                        class="axis-sales-row-button axis-sales-cancel">

                                                    Cancelar

                                                </button>

                                            </form>

                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        }

    </div>

</section>


<style>

    /* =====================================================
           PÁGINA
           ===================================================== */

    .axis-sales-page {
        width: 100%;
        max-width: 1240px;
        margin: 0 auto;
        padding: 44px 34px 70px;
        color: #e7e7ea;
    }


    /* =====================================================
           HEADER
           ===================================================== */

    .axis-sales-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 30px;
    }


    .axis-sales-kicker {
        display: block;
        margin-bottom: 10px;
        color: #777985;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 2.8px;
    }


    .axis-sales-header h1 {
        margin: 0;
        color: #f5f5f7;
        font-size: 52px;
        line-height: 1;
        font-weight: 700;
        letter-spacing: -1.8px;
    }


    .axis-sales-header p {
        margin: 11px 0 0;
        color: #858690;
        font-size: 13px;
    }


    /* =====================================================
           ACCIONES HEADER
           ===================================================== */

    .axis-sales-actions {
        display: flex;
        align-items: center;
        gap: 9px;
        flex-wrap: wrap;
    }


    .axis-sales-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 40px;
        padding: 0 16px;
        border-radius: 11px;
        text-decoration: none;
        font-size: 11px;
        font-weight: 650;
        transition: .2s ease;
        cursor: pointer;
        white-space: nowrap;
    }


        .axis-sales-button:hover {
            transform: translateY(-1px);
        }


    .axis-sales-button-secondary {
        color: #c9c9cf;
        background: #17171b;
        border: 1px solid #292a30;
    }


        .axis-sales-button-secondary:hover {
            color: #fff;
            background: #1d1d22;
        }


    .axis-sales-button-primary {
        color: #16161a;
        background: #f1edf4;
        border: 1px solid #f1edf4;
    }


        .axis-sales-button-primary:hover {
            color: #111;
            background: #fff;
        }


    /* =====================================================
           ALERTAS
           ===================================================== */

    .axis-sales-alert {
        margin-bottom: 18px;
        padding: 13px 16px;
        border-radius: 11px;
        font-size: 12px;
    }


    .axis-sales-alert-success {
        color: #a8d7ad;
        background: rgba(81, 145, 88, .10);
        border: 1px solid rgba(106, 167, 112, .18);
    }


    .axis-sales-alert-error {
        color: #e2a4a4;
        background: rgba(160, 65, 65, .10);
        border: 1px solid rgba(190, 85, 85, .18);
    }


    /* =====================================================
           CARD
           ===================================================== */

    .axis-sales-card {
        overflow: hidden;
        border: 1px solid #292a30;
        border-radius: 20px;
        background: linear-gradient( 145deg, rgba(25,25,29,.95), rgba(15,15,18,.98) );
        box-shadow: 0 20px 55px rgba(0,0,0,.22);
    }


    /* =====================================================
           CARD HEADER
           ===================================================== */

    .axis-sales-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 23px 24px;
        border-bottom: 1px solid #292a30;
    }


    .axis-sales-card-kicker {
        display: block;
        margin-bottom: 6px;
        color: #696b75;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.8px;
    }


    .axis-sales-card-header h2 {
        margin: 0;
        color: #e7e7eb;
        font-size: 16px;
        font-weight: 650;
    }


    .axis-sales-card-header p {
        margin: 5px 0 0;
        color: #777983;
        font-size: 11px;
    }


    .axis-sales-count {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 30px;
        height: 30px;
        padding: 0 9px;
        border: 1px solid #303139;
        border-radius: 9px;
        color: #bcbcc3;
        background: #1a1a1f;
        font-size: 11px;
        font-weight: 650;
    }


    /* =====================================================
           TABLA
           ===================================================== */

    .axis-sales-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }


    .axis-sales-table {
        width: 100%;
        min-width: 1050px;
        border-collapse: collapse;
    }


        .axis-sales-table th {
            padding: 14px 18px;
            color: #666872;
            background: rgba(255,255,255,.018);
            border-bottom: 1px solid #292a30;
            text-align: left;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.5px;
            white-space: nowrap;
        }


        .axis-sales-table td {
            padding: 17px 18px;
            color: #b8b8bf;
            border-bottom: 1px solid rgba(255,255,255,.055);
            font-size: 12px;
            vertical-align: middle;
        }


        .axis-sales-table tbody tr {
            transition: background .18s ease;
        }


            .axis-sales-table tbody tr:hover {
                background: rgba(255,255,255,.025);
            }


            .axis-sales-table tbody tr:last-child td {
                border-bottom: none;
            }


    /* =====================================================
           VENTA
           ===================================================== */

    .axis-sales-record {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }


        .axis-sales-record strong {
            color: #e5e5e9;
            font-size: 12px;
            font-weight: 650;
        }


        .axis-sales-record span {
            color: #686a74;
            font-size: 10px;
        }


    /* =====================================================
           CLIENTE
           ===================================================== */

    .axis-sales-client {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 190px;
    }


    .axis-sales-client-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 36px;
        width: 36px;
        height: 36px;
        border: 1px solid #34353d;
        border-radius: 11px;
        color: #d9d9de;
        background: #202126;
        font-size: 12px;
        font-weight: 700;
    }


    .axis-sales-client div:last-child {
        min-width: 0;
    }


    .axis-sales-client strong {
        display: block;
        max-width: 190px;
        overflow: hidden;
        color: #d8d8dd;
        font-size: 12px;
        font-weight: 600;
        text-overflow: ellipsis;
        white-space: nowrap;
    }


    .axis-sales-client span {
        display: block;
        margin-top: 3px;
        color: #656771;
        font-size: 9px;
    }


    /* =====================================================
           FECHA
           ===================================================== */

    .axis-sales-date {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }


        .axis-sales-date strong {
            color: #c6c6cc;
            font-size: 11px;
            font-weight: 550;
        }


        .axis-sales-date span {
            color: #686a73;
            font-size: 10px;
        }


    /* =====================================================
           TOTAL
           ===================================================== */

    .axis-sales-total {
        color: #e1e1e5;
        font-size: 13px;
        font-weight: 650;
        white-space: nowrap;
    }


    /* =====================================================
           FORMA DE PAGO
           ===================================================== */

    .axis-sales-payment {
        display: inline-flex;
        padding: 6px 9px;
        border: 1px solid #303139;
        border-radius: 8px;
        color: #aeb0b7;
        background: #19191e;
        font-size: 10px;
        white-space: nowrap;
    }


    /* =====================================================
           ESTADO
           ===================================================== */

    .axis-sales-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 9px;
        border-radius: 8px;
        font-size: 10px;
        font-weight: 600;
        white-space: nowrap;
    }


    .axis-sales-status-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
    }


    .axis-sales-status-completed {
        color: #9fcba2;
        background: rgba(83,139,88,.12);
        border: 1px solid rgba(93,148,98,.18);
    }


        .axis-sales-status-completed .axis-sales-status-dot {
            background: #79b57e;
        }


    .axis-sales-status-pending {
        color: #d3c58a;
        background: rgba(145,126,59,.12);
        border: 1px solid rgba(153,134,64,.18);
    }


        .axis-sales-status-pending .axis-sales-status-dot {
            background: #b7a65b;
        }


    .axis-sales-status-cancelled {
        color: #d39b9b;
        background: rgba(142,64,64,.12);
        border: 1px solid rgba(158,75,75,.18);
    }


        .axis-sales-status-cancelled .axis-sales-status-dot {
            background: #bd7373;
        }


    /* =====================================================
           ACCIONES
           ===================================================== */

    .axis-sales-actions-column {
        min-width: 270px;
    }


    .axis-sales-row-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }


        .axis-sales-row-actions form {
            margin: 0;
        }


    .axis-sales-row-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 31px;
        padding: 0 10px;
        border: 1px solid #303139;
        border-radius: 8px;
        color: #c3c3c9;
        background: #1b1b20;
        text-decoration: none;
        font-family: inherit;
        font-size: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: .18s ease;
    }


        .axis-sales-row-button:hover {
            color: #fff;
            background: #25252b;
            border-color: #41424b;
        }


    .axis-sales-complete {
        color: #9fcba2;
        background: rgba(83,139,88,.08);
        border-color: rgba(93,148,98,.18);
    }


        .axis-sales-complete:hover {
            color: #b8dfbb;
            background: rgba(83,139,88,.15);
        }


    .axis-sales-cancel {
        color: #d39b9b;
        background: rgba(142,64,64,.08);
        border-color: rgba(158,75,75,.18);
    }


        .axis-sales-cancel:hover {
            color: #e4b2b2;
            background: rgba(142,64,64,.15);
        }


    /* =====================================================
           EMPTY STATE
           ===================================================== */

    .axis-sales-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 330px;
        padding: 50px 25px;
        text-align: center;
    }


    .axis-sales-empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        margin-bottom: 18px;
        border: 1px solid #303139;
        border-radius: 14px;
        color: #aaaab2;
        background: #1b1b20;
        font-size: 20px;
    }


    .axis-sales-empty h3 {
        margin: 0;
        color: #dddde2;
        font-size: 16px;
        font-weight: 650;
    }


    .axis-sales-empty p {
        margin: 8px 0 20px;
        color: #70727c;
        font-size: 12px;
    }


    /* =====================================================
           RESPONSIVE
           ===================================================== */

    @@media (max-width: 900px) {

        .axis-sales-page {
            padding: 28px 18px 50px;
        }

        .axis-sales-header {
            flex-direction: column;
            align-items: flex-start;
        }

            .axis-sales-header h1 {
                font-size: 42px;
            }

        .axis-sales-actions {
            width: 100%;
        }

        .axis-sales-button {
            flex: 1;
        }
    }


    @@media (max-width: 550px) {

        .axis-sales-page {
            padding: 22px 12px 40px;
        }

        .axis-sales-header h1 {
            font-size: 36px;
        }

        .axis-sales-actions {
            flex-direction: column;
        }

        .axis-sales-button {
            width: 100%;
        }

        .axis-sales-card-header {
            padding: 19px;
        }
    }

</style>