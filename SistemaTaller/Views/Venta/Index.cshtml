@model IEnumerable<Negocios.DTOs.VentaDto>

@{
    ViewData["Title"] = "Ventas";
}

<div class="page-header">
    <div>
        <span class="eyebrow">VENTAS · REGISTRO</span>
        <h1>Ventas</h1>
        <p>Gestiona las ventas realizadas en el taller.</p>
    </div>

    <div class="page-actions">
        <a asp-controller="Venta"
           asp-action="PorEstado"
           asp-route-estado="Pendiente"
           class="btn btn-secondary">
            Pendientes
        </a>

        <a asp-controller="Venta"
           asp-action="Recientes"
           class="btn btn-secondary">
            Recientes
        </a>

        <a asp-controller="Venta"
           asp-action="Create"
           class="btn btn-primary">
            + Nueva venta
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-error">
        @TempData["Error"]
    </div>
}

<div class="section-card">

    <div class="section-card-header">
        <div>
            <h2>Ventas registradas</h2>
            <p>@Model.Count() ventas encontradas.</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <h3>No hay ventas registradas</h3>
            <p>Registra la primera venta para comenzar.</p>

            <a asp-controller="Venta"
               asp-action="Create"
               class="btn btn-primary">
                Registrar venta
            </a>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>VENTA</th>
                        <th>CLIENTE</th>
                        <th>FECHA</th>
                        <th>TOTAL</th>
                        <th>FORMA DE PAGO</th>
                        <th>ESTADO</th>
                        <th>ACCIONES</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var venta in Model)
                    {
                        <tr>
                            <td>
                                <div class="record-title">
                                    @venta.NumeroVenta
                                </div>

                                <div class="record-subtitle">
                                    Venta #@venta.IdVenta
                                </div>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(venta.Cliente)
                                                        ? "Cliente no disponible"
                                                        : venta.Cliente)
                                                                    </td>

                            <td>
                                @venta.FechaVenta.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                <strong>
                                    @venta.Total.ToString("C")
                                </strong>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(venta.FormaPago)
                                                        ? "—"
                                                        : venta.FormaPago)
                    </td>

                            <td>
                        @{
                                    var estadoClass =
                                    venta.Estado switch
                                    {
                                        "Completada" => "status-completed",
                                        "Cancelada" => "status-cancelled",
                                        _ => "status-pending"
                                    };
                                }

                                <span class="status-badge @estadoClass">
                                    @venta.Estado
                                </span>
                            </td>

                            <td>
                                <div class="action-buttons">

                                    <a asp-controller="Venta"
                                       asp-action="Details"
                                       asp-route-id="@venta.IdVenta"
                                       class="btn btn-small">
                                        Ver
                                    </a>

                                    @if (venta.Estado != "Completada" &&
                                                                venta.Estado != "Cancelada")
                                    {
                                        <a asp-controller="Venta"
                                           asp-action="Edit"
                                           asp-route-id="@venta.IdVenta"
                                           class="btn btn-small">
                                            Editar
                                        </a>

                                        <form asp-controller="Venta"
                                              asp-action="CambiarEstado"
                                              asp-route-id="@venta.IdVenta"
                                              method="post"
                                              style="display:inline;">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="estado"
                                                   value="Completada" />

                                            <button type="submit"
                                                    class="btn btn-small btn-complete">
                                                Completar
                                            </button>
                                        </form>

                                        <form asp-controller="Venta"
                                              asp-action="CambiarEstado"
                                              asp-route-id="@venta.IdVenta"
                                              method="post"
                                              style="display:inline;">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="estado"
                                                   value="Cancelada" />

                                            <button type="submit"
                                                    class="btn btn-small btn-cancel">
                                                Cancelar
                                            </button>
                                        </form>
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 24px;
        margin-bottom: 32px;
    }

    .eyebrow {
        display: block;
        margin-bottom: 10px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 3px;
        color: #777;
    }

    .page-header h1 {
        margin: 0;
        font-size: 42px;
        font-weight: 700;
        color: #111;
    }

    .page-header p {
        margin: 8px 0 0;
        color: #777;
    }

    .page-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 9px 16px;
        border-radius: 10px;
        border: 1px solid #ddd;
        background: #fff;
        color: #222;
        text-decoration: none;
        cursor: pointer;
        font-size: 13px;
        transition: .2s ease;
    }

        .btn:hover {
            transform: translateY(-1px);
        }

    .btn-primary {
        background: #222;
        border-color: #222;
        color: #fff;
    }

    .btn-secondary {
        background: #fff;
    }

    .btn-small {
        min-height: 34px;
        padding: 7px 11px;
        font-size: 12px;
    }

    .btn-complete {
        background: #edf6ed;
        border-color: #c9dfc9;
        color: #315c31;
    }

    .btn-cancel {
        background: #faf0f0;
        border-color: #e5cccc;
        color: #8a3d3d;
    }

    .alert {
        margin-bottom: 20px;
        padding: 14px 18px;
        border-radius: 12px;
        font-size: 13px;
    }

    .alert-success {
        background: #edf5e9;
        border: 1px solid #c9dbc1;
        color: #41603a;
    }

    .alert-error {
        background: #f8eeee;
        border: 1px solid #e5c8c8;
        color: #8b3d3d;
    }

    .section-card {
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0,0,0,.04);
    }

    .section-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #e8e8e8;
    }

        .section-card-header h2 {
            margin: 0;
            font-size: 18px;
        }

        .section-card-header p {
            margin: 5px 0 0;
            color: #777;
            font-size: 13px;
        }

    .table-wrapper {
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table th {
            padding: 15px 18px;
            text-align: left;
            font-size: 10px;
            letter-spacing: 1.5px;
            color: #777;
            background: #fafafa;
            border-bottom: 1px solid #e5e5e5;
        }

        .data-table td {
            padding: 17px 18px;
            border-bottom: 1px solid #eee;
            font-size: 13px;
            color: #555;
            vertical-align: middle;
        }

        .data-table tr:last-child td {
            border-bottom: none;
        }

    .record-title {
        font-weight: 700;
        color: #222;
    }

    .record-subtitle {
        margin-top: 4px;
        font-size: 11px;
        color: #999;
    }

    .status-badge {
        display: inline-flex;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-completed {
        background: #e8f2e5;
        color: #42623c;
    }

    .status-pending {
        background: #f5f1df;
        color: #75672e;
    }

    .status-cancelled {
        background: #f4e7e7;
        color: #824141;
    }

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .empty-state {
        padding: 70px 30px;
        text-align: center;
    }

        .empty-state h3 {
            margin: 0 0 8px;
            color: #222;
        }

        .empty-state p {
            margin: 0 0 20px;
            color: #777;
        }

    @@media (max-width: 900px)  {
        .page-header

    {
        align-items: flex-start;
        flex-direction: column;
    }

    }
</style>