@model Negocios.DTOs.ClienteGuardarDto

@{
    Layout = "_LayoutInterno";
    ViewData["Title"] = "Editar cliente";
}

<section class="axis-page">

    <div class="axis-page-header">

        <div>
            <span class="axis-page-kicker">
                CLIENTES Y VEHÍCULOS
            </span>

            <h1>Editar cliente</h1>

            <p>
                Actualiza la información del cliente.
            </p>
        </div>

        <div class="axis-page-actions">

            <a asp-action="Details"
               asp-route-id="@ViewBag.IdCliente"
               class="axis-button axis-button-secondary">
                Ver cliente
            </a>

            <a asp-action="Index"
               class="axis-button axis-button-secondary">
                ← Volver
            </a>

        </div>

    </div>


    <div class="axis-form-card">

        <form asp-action="Edit"
              asp-route-id="@ViewBag.IdCliente"
              method="post"
              class="axis-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="axis-form-validation">
            </div>


            <div class="axis-form-section">

                <div class="axis-form-section-title">
                    Información personal
                </div>

                <div class="axis-form-grid">

                    <div class="axis-field">
                        <label asp-for="Cedula">
                            Cédula
                        </label>

                        <input asp-for="Cedula"
                               placeholder="Ej. 1-1234-5678" />

                        <span asp-validation-for="Cedula"></span>
                    </div>


                    <div class="axis-field">
                        <label asp-for="Nombre">
                            Nombre
                        </label>

                        <input asp-for="Nombre" />

                        <span asp-validation-for="Nombre"></span>
                    </div>


                    <div class="axis-field">
                        <label asp-for="Apellido1">
                            Primer apellido
                        </label>

                        <input asp-for="Apellido1" />

                        <span asp-validation-for="Apellido1"></span>
                    </div>


                    <div class="axis-field">
                        <label asp-for="Apellido2">
                            Segundo apellido
                        </label>

                        <input asp-for="Apellido2" />

                        <span asp-validation-for="Apellido2"></span>
                    </div>

                </div>

            </div>


            <div class="axis-form-section">

                <div class="axis-form-section-title">
                    Información de contacto
                </div>

                <div class="axis-form-grid">

                    <div class="axis-field">
                        <label asp-for="Telefono">
                            Teléfono
                        </label>

                        <input asp-for="Telefono" />

                        <span asp-validation-for="Telefono"></span>
                    </div>


                    <div class="axis-field">
                        <label asp-for="Correo">
                            Correo electrónico
                        </label>

                        <input asp-for="Correo"
                               type="email" />

                        <span asp-validation-for="Correo"></span>
                    </div>


                    <div class="axis-field axis-field-full">
                        <label asp-for="Direccion">
                            Dirección
                        </label>

                        <textarea asp-for="Direccion"
                                  rows="3">
                        </textarea>

                        <span asp-validation-for="Direccion"></span>
                    </div>

                </div>

            </div>


            <div class="axis-form-actions">

                <a asp-action="Index"
                   class="axis-button axis-button-secondary">
                    Cancelar
                </a>

                <button type="submit"
                        class="axis-button axis-button-primary">
                    Guardar cambios
                </button>

            </div>

        </form>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}