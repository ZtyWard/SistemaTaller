@model Negocios.DTOs.ProductoGuardarDto

@{
    Layout = "_LayoutInterno";
    ViewData["Title"] = "Nuevo producto";

    var categorias =
        ViewBag.Categorias
        as IEnumerable<Negocios.DTOs.CategoriaProductoDto>
        ?? Enumerable.Empty<Negocios.DTOs.CategoriaProductoDto>();
}

<section class="axis-page">

    <div class="axis-page-header">

        <div>

            <span class="axis-page-kicker">
                INVENTARIO
            </span>

            <h1>
                Nuevo producto
            </h1>

            <p>
                Registra un nuevo producto en el inventario.
            </p>

        </div>

        <div class="axis-page-actions">

            <a asp-action="Index"
               class="axis-button axis-button-secondary">
                ← Volver
            </a>

        </div>

    </div>


    <div class="axis-form-card">

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data"
              class="axis-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="axis-form-validation">
            </div>


            <!-- ========================================= -->
            <!-- IDENTIFICACIÓN -->
            <!-- ========================================= -->

            <div class="axis-form-section">

                <div class="axis-form-section-title">
                    Identificación
                </div>

                <div class="axis-form-grid">

                    <div class="axis-field">

                        <label asp-for="Codigo">
                            Código interno
                        </label>

                        <input asp-for="Codigo"
                               placeholder="Ej. FIL-001"
                               autocomplete="off" />

                        <span asp-validation-for="Codigo"></span>

                    </div>


                    <div class="axis-field">

                        <label>
                            Código de barras
                        </label>

                        <input type="text"
                               value="Se generará automáticamente"
                               readonly
                               disabled
                               class="axis-input-disabled" />

                        <small>
                            AXIS generará automáticamente un código único.
                        </small>

                    </div>


                    <div class="axis-field">

                        <label asp-for="Nombre">
                            Nombre
                        </label>

                        <input asp-for="Nombre"
                               placeholder="Nombre del producto"
                               autocomplete="off" />

                        <span asp-validation-for="Nombre"></span>

                    </div>


                    <div class="axis-field">

                        <label asp-for="IdCategoriaProducto">
                            Categoría
                        </label>

                        <select asp-for="IdCategoriaProducto">

                            <option value="">
                                Seleccione una categoría
                            </option>

                            @foreach (var categoria in categorias)
                            {
                                <option value="@categoria.IdCategoriaProducto">
                                    @categoria.Nombre
                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdCategoriaProducto"></span>

                    </div>


                    <div class="axis-field axis-field-full">

                        <label asp-for="Descripcion">
                            Descripción
                        </label>

                        <textarea asp-for="Descripcion"
                                  rows="4"
                                  placeholder="Descripción del producto..."></textarea>

                        <span asp-validation-for="Descripcion"></span>

                    </div>

                </div>

            </div>


            <!-- ========================================= -->
            <!-- IMAGEN -->
            <!-- ========================================= -->

            <div class="axis-form-section">

                <div class="axis-form-section-title">
                    Imagen del producto
                </div>

                <div class="axis-form-grid">

                    <div class="axis-field axis-field-full">

                        <label for="Imagen">
                            Fotografía
                        </label>

                        <input type="file"
                               id="Imagen"
                               name="Imagen"
                               accept=".jpg,.jpeg,.png,.webp" />

                        <small>
                            Formatos permitidos: JPG, JPEG, PNG y WEBP.
                            Máximo 5 MB.
                        </small>

                    </div>

                </div>

            </div>


            <!-- ========================================= -->
            <!-- PRECIOS -->
            <!-- ========================================= -->

            <div class="axis-form-section">

                <div class="axis-form-section-title">
                    Precios
                </div>

                <div class="axis-form-grid">

                    <div class="axis-field">

                        <label asp-for="PrecioCompra">
                            Precio de compra
                        </label>

                        <input asp-for="PrecioCompra"
                               type="number"
                               step="0.01"
                               min="0"
                               placeholder="0.00" />

                        <span asp-validation-for="PrecioCompra"></span>

                    </div>


                    <div class="axis-field">

                        <label asp-for="PrecioVenta">
                            Precio de venta
                        </label>

                        <input asp-for="PrecioVenta"
                               type="number"
                               step="0.01"
                               min="0"
                               placeholder="0.00" />

                        <span asp-validation-for="PrecioVenta"></span>

                    </div>

                </div>

            </div>


            <!-- ========================================= -->
            <!-- INVENTARIO -->
            <!-- ========================================= -->

            <div class="axis-form-section">

                <div class="axis-form-section-title">
                    Inventario
                </div>

                <div class="axis-form-grid">

                    <div class="axis-field">

                        <label asp-for="Stock">
                            Stock inicial
                        </label>

                        <input asp-for="Stock"
                               type="number"
                               min="0"
                               placeholder="0" />

                        <small>
                            Solo corresponde al inventario inicial.
                        </small>

                        <span asp-validation-for="Stock"></span>

                    </div>


                    <div class="axis-field">

                        <label asp-for="StockMinimo">
                            Stock mínimo
                        </label>

                        <input asp-for="StockMinimo"
                               type="number"
                               min="0"
                               placeholder="5" />

                        <span asp-validation-for="StockMinimo"></span>

                    </div>


                    <div class="axis-field">

                        <label asp-for="Activo">
                            Estado
                        </label>

                        <select asp-for="Activo">

                            <option value="true">
                                Activo
                            </option>

                            <option value="false">
                                Inactivo
                            </option>

                        </select>

                        <span asp-validation-for="Activo"></span>

                    </div>

                </div>

            </div>


            <!-- ========================================= -->
            <!-- ACCIONES -->
            <!-- ========================================= -->

            <div class="axis-form-actions">

                <a asp-action="Index"
                   class="axis-button axis-button-secondary">
                    Cancelar
                </a>

                <button type="submit"
                        class="axis-button axis-button-primary">
                    Guardar producto
                </button>

            </div>

        </form>

    </div>

</section>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}