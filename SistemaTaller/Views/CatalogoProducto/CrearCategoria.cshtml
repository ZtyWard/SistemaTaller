@model Negocios.DTOs.CategoriaProductoGuardarDto

@{
    ViewData["Title"] = "Nueva categoría";
}

<div class="axis-page axis-modern-page">

    <div class="axis-page-header axis-modern-header">

        <div>

            <span class="axis-page-kicker">
                CATÁLOGO · PRODUCTOS
            </span>

            <h1>
                Nueva categoría
            </h1>

            <p>
                Registra una nueva categoría
                para organizar los productos del taller.
            </p>

        </div>


        <div class="axis-page-actions">

            <a asp-action="Categorias"
               class="axis-button axis-button-secondary">

                <i class="bi bi-arrow-left"></i>

                Volver

            </a>

        </div>

    </div>


    <div class="axis-form-card axis-modern-card axis-category-form-card">

        <form asp-action="CrearCategoria"
              method="post"
              class="axis-form axis-modern-form">

            @Html.AntiForgeryToken()


            <div asp-validation-summary="ModelOnly"
                 class="axis-form-validation">
            </div>


            <section class="axis-form-section axis-modern-section">

                <div class="axis-form-section-title">
                    Datos de la categoría
                </div>


                <div class="axis-form-grid">

                    <div class="axis-field axis-field-full">

                        <label asp-for="Nombre">
                            Nombre de la categoría
                        </label>

                        <input asp-for="Nombre"
                               placeholder="Ej. Lubricantes"
                               autocomplete="off" />

                        <span asp-validation-for="Nombre"></span>

                    </div>


                    <div class="axis-field axis-field-full">

                        <label class="axis-check-card axis-check-card-inline"
                               for="Activo">

                            <input asp-for="Activo"
                                   id="Activo" />

                            <span class="axis-check-box">
                            </span>

                            <span class="axis-check-content">

                                <strong>
                                    Categoría activa
                                </strong>

                                <small>
                                    La categoría estará disponible
                                    para organizar productos.
                                </small>

                            </span>

                        </label>

                    </div>

                </div>

            </section>


            <div class="axis-form-actions axis-modern-actions">

                <a asp-action="Categorias"
                   class="axis-button axis-button-secondary">

                    Cancelar

                </a>


                <button type="submit"
                        class="axis-button axis-button-primary">

                    <i class="bi bi-plus-lg"></i>

                    Crear categoría

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}