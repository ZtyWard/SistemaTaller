@model IEnumerable<Negocios.DTOs.RolAdministracionDto>

@{
    ViewData["Title"] = "Administración de roles";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>

            <div class="text-muted small">
                AXIS · SEGURIDAD
            </div>

            <h1 class="fw-bold mb-1">
                Administración de roles
            </h1>

            <p class="text-muted mb-0">
                Gestiona los roles y permisos de acceso
                del sistema.
            </p>

        </div>

        @if (User.HasClaim(
                "Permiso",
                Negocios.Seguridad.Permisos.RolesAdministrar))
        {
            <a asp-action="Create"
               class="btn btn-primary">
                + Nuevo rol
            </a>
        }

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>
                                Rol
                            </th>

                            <th>
                                Usuarios
                            </th>

                            <th>
                                Permisos
                            </th>

                            <th class="text-end">
                                Acciones
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var rol in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @rol.Nombre
                                    </strong>
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @rol.CantidadUsuarios
                                    </span>
                                </td>

                                <td>

                                    @if (rol.Permisos.Any())
                                    {
                                        <span class="badge bg-primary">
                                            @rol.Permisos.Count
                                            permisos
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Sin permisos
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    @if (User.HasClaim(
                                                                    "Permiso",
                                                                    Negocios.Seguridad.Permisos.RolesAdministrar))
                                    {
                                        <div class="btn-group">

                                            <a asp-action="Edit"
                                               asp-route-id="@rol.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Editar
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@rol.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('¿Desea eliminar este rol?');">
                                                    Eliminar
                                                </button>

                                            </form>

                                        </div>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <h5>
                        No hay roles registrados.
                    </h5>

                    <p class="text-muted">
                        Cree el primer rol desde
                        "Nuevo rol".
                    </p>

                </div>
            }

        </div>

    </div>

</div>