@model Negocios.DTOs.RolAdministracionDto

@{
    ViewData["Title"] = "Nuevo rol";
    var puedeAdministrarPermisos =
        ViewBag.PuedeAdministrarPermisos as bool?
        ?? false;
}

<div class="container-fluid py-4">

    <div class="mb-4">

        <div class="text-muted small">
            AXIS · SEGURIDAD
        </div>

        <h1 class="fw-bold mb-1">
            Nuevo rol
        </h1>

        <p class="text-muted mb-0">
            Crea un rol y configura sus permisos.
        </p>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-4">

                    <label asp-for="Nombre"
                           class="form-label fw-semibold">
                        Nombre del rol
                    </label>

                    <input asp-for="Nombre"
                           class="form-control"
                           maxlength="256"
                           placeholder="Ej. Jefe de Taller" />

                    <span asp-validation-for="Nombre"
                          class="text-danger">
                    </span>

                </div>

                @if (puedeAdministrarPermisos)
                {
                    <hr />

                    <h5 class="mb-3">
                        Permisos
                    </h5>

                    <p class="text-muted">
                        Selecciona los permisos que tendrá
                        este rol.
                    </p>

                    @foreach (
                                    var grupo in Model.PermisosDisponibles
                                    .GroupBy(p => p.Split('.')[0])
                                    .OrderBy(g => g.Key))
                    {
                        <div class="mb-4">

                            <h6 class="fw-bold">
                                @grupo.Key
                            </h6>

                            <div class="row">

                                @foreach (var permiso in grupo)
                                {
                                    <div class="col-md-4 mb-2">

                                        <div class="form-check">

                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="Permisos"
                                                   value="@permiso"
                                                   id="permiso_@permiso.Replace(".", "_")" />

                                            <label class="form-check-label"
                                                   for="permiso_@permiso.Replace(".", "_")">
                                                @permiso
                                            </label>

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        El rol se creará sin permisos.
                        Un administrador con permiso para
                        administrar permisos podrá configurarlos
                        posteriormente.
                    </div>
                }

                <div class="d-flex gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Crear rol
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}